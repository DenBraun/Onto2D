  "claims": [
    {
      "id": "F01",
      "status": "conditional-derivation",
      "source": "topology",
      "pages": [
        6,
        7,
        8,
        9,
        10
      ],
      "statement": "Geometry and operator uniqueness are conditional on the declared two directions, bilinear quadratic class and exclusion rules; formal admissibility is not empirical identification.",
      "entityIds": [
        "l0:hyperbolic-frame",
        "l0:quadratic-action"
      ]
    },
    {
      "id": "F02",
      "status": "algebraic-inconsistency",
      "source": "topology",
      "pages": [
        8,
        13
      ],
      "statement": "Equations (24)-(26), also (8)-(9), give opposite signs for m2 after substitution. Existing Phase-B case uses its own consistent +dtt-dxx convention.",
      "entityIds": [
        "l0:closure-parameter",
        "l0:quadratic-action",
        "l0:oscillatory-mode"
      ]
    },
    {
      "id": "F03",
      "status": "unsupported-implication",
      "source": "topology",
      "pages": [
        14,
        15,
        33,
        34
      ],
      "statement": "Stationarity of an indefinite action is not sufficient for a minimum or perturbative stability. Keep all three claims separate.",
      "entityIds": [
        "l0:quadratic-action",
        "l0:cohort-selection"
      ]
    },
    {
      "id": "F04",
      "status": "conditional-definition",
      "source": "topology",
      "pages": [
        16,
        17
      ],
      "statement": "The first undirected simple cycle has three vertices; importing that representation excludes dyadic loops by definition and does not establish a universal physical minimum.",
      "entityIds": [
        "l0:triadic-closure"
      ]
    },
    {
      "id": "F05",
      "status": "counterexample-to-sufficiency",
      "source": "topology",
      "pages": [
        19,
        20,
        25
      ],
      "statement": "Wave-number and frequency sums can vanish for a periodic extended plane-wave sum; balance alone does not imply localization or nonlinear self-binding.",
      "entityIds": [
        "l0:triadic-closure",
        "l0:crt-node"
      ]
    },
    {
      "id": "F06",
      "status": "counterexample-to-sufficiency",
      "source": "topology",
      "pages": [
        18,
        19,
        21,
        22,
        23
      ],
      "statement": "rho is nonnegative but can remain nonzero after removing a mode; Gamma also depends on support and measure. Neither alone detects irreducible closure.",
      "entityIds": [
        "l0:local-density",
        "l0:integrated-density"
      ]
    },
    {
      "id": "F07",
      "status": "model-specific-negative-result",
      "source": "topology",
      "pages": [
        25,
        26
      ],
      "statement": "The independent-field variation is underspecified in the source; the declared free cubic case is unbounded below, and tested stabilized cases fail full objecthood.",
      "entityIds": [
        "l0:nonlinear-action",
        "l0:crt-node"
      ]
    },
    {
      "id": "F08",
      "status": "mapping-ambiguity",
      "source": "topology",
      "pages": [
        24,
        25,
        32
      ],
      "statement": "The paper locates CRT objecthood at the end of Phase B and later describes formed nodes in Phase C; catalogue 0.7 and 0.8 use Phase C. Preserve source coordinates separately.",
      "entityIds": [
        "l0:crt-node",
        "l0:local-density",
        "l0:integrated-density"
      ]
    },
    {
      "id": "F09",
      "status": "open-model-obligation",
      "source": "topology",
      "pages": [
        27,
        28,
        29,
        30,
        31,
        32,
        33,
        35
      ],
      "statement": "Coupling, an effective description and a new carrier interface must be evaluated; a nonzero coupling term or a graph quotient alone does not demonstrate a new stable regime.",
      "entityIds": [
        "l0:ensemble",
        "l0:ensemble-quantum",
        "l0:carrier-promotion"
      ]
    },
    {
      "id": "F10",
      "status": "open-model-obligation",
      "source": "topology",
      "pages": [
        12,
        13
      ],
      "statement": "E=hbar omega and p=hbar k do not themselves constrain omega and k to discrete values.",
      "entityIds": [
        "l0:discrete-scale"
      ]
    },
    {
      "id": "F11",
      "status": "open-model-obligation",
      "source": "topology",
      "pages": [
        34
      ],
      "statement": "The selection functional requires explicit chi definitions, coefficients, units and comparison domain; an argmin is not a unique solution when minima tie.",
      "entityIds": [
        "l0:cohort-selection"
      ]
    },
    {
      "id": "F12",
      "status": "source-support-unresolved",
      "source": "topology",
      "pages": [],
      "statement": "The named 0.20-0.23 directional extension is not established by the topology paper; relation to perturbative persistence does not derive the whole branch.",
      "entityIds": [
        "l0:anisotropy",
        "l0:deformation",
        "l0:directional-gradient",
        "l0:transport-bias"
      ]
    }
  ],
  "constructionRules": [
    {
      "id": "R-mode",
      "inputEntityIds": [
        "l0:sequential-axis",
        "l0:spatial-axis",
        "l0:hyperbolic-frame",
        "l0:quadratic-action",
        "l0:closure-parameter"
      ],
      "outputEntityIds": [
        "l0:oscillatory-mode"
      ],
      "inputLogic": "joint prerequisites plus a declared numerical mode candidate",
      "conditions": [
        "consistent operator and dispersion convention",
        "specified domain, units and boundary conditions",
        "stationarity residual and convergence within declared tolerances"
      ],
      "sourceClaims": [
        "F01",
        "F02",
        "F03",
        "F10"
      ],
      "status": "bounded-case-controls-available; source-formula-reconciliation-pending"
    },
    {
      "id": "R-triad",
      "inputEntityIds": [
        "l0:oscillatory-mode",
        "l0:triadic-closure"
      ],
      "outputEntityIds": [
        "l0:triad-configuration"
      ],
      "inputLogic": "three distinct mode instances jointly, evaluated under the triadic-closure rule",
      "conditions": [
        "admitted modes",
        "signed frequency and wave-number balance",
        "declared simple-cycle and rank surrogate",
        "removal witnesses for the exact closure predicate"
      ],
      "sourceClaims": [
        "F04",
        "F05"
      ],
      "status": "bounded-Phase-B-positive-and-negative-controls-available"
    },
    {
      "id": "R-object",
      "inputEntityIds": [
        "l0:triad-configuration",
        "l0:nonlinear-action",
        "l0:local-density",
        "l0:integrated-density"
      ],
      "outputEntityIds": [
        "l0:crt-node"
      ],
      "inputLogic": "one triad candidate AND every objecthood condition",
      "conditions": [
        "declared independent variables and equations",
        "localization under domain enlargement",
        "nontrivial concentration",
        "stationarity",
        "specified static and dynamic perturbative persistence"
      ],
      "sourceClaims": [
        "F05",
        "F06",
        "F07",
        "F08"
      ],
      "status": "no-object-qualified-candidate-in-existing-portable-expanded-case"
    },
    {
      "id": "R-ensemble",
      "inputEntityIds": [
        "l0:crt-node",
        "l0:ensemble-action"
      ],
      "outputEntityIds": [
        "l0:ensemble",
        "l0:synchronization"
      ],
      "inputLogic": "multiple admitted CRT instances AND a declared coupling model",
      "conditions": [
        "carrier closure",
        "collective persistence",
        "comparison with uncoupled and alternative couplings",
        "defined collective observables"
      ],
      "sourceClaims": [
        "F09"
      ],
      "status": "not-instantiated-no-qualified-CRT-inputs-in-existing-case"
    },
    {
      "id": "R-promote",
      "inputEntityIds": [
        "l0:ensemble",
        "l0:synchronization",
        "l0:carrier-promotion"
      ],
      "outputEntityIds": [
        "l0:ensemble-quantum"
      ],
      "inputLogic": "admitted collective candidate AND a validated macro description; synchronization alone is insufficient",
      "conditions": [
        "explicit forward abstraction map",
        "declared state and intervention domain",
        "macro closure error and uncertainty",
        "substitution/interface test",
        "independent target or analytical certificate"
      ],
      "sourceClaims": [
        "F09"
      ],
      "status": "open-no-effective-Level-1-dynamics-derived"
    },
