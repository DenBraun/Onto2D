{
  "name": "@onto2d/engine",
  "version": "0.1.0",
  "description": "Headless public runtime facade for verified Onto2D Model Packs, model queries, workspaces, analyses, and structural diffs.",
  "type": "module",
  "types": "./src/index.d.ts",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DenBraun/Onto2D.git",
    "directory": "packages/engine"
  },
  "bugs": {
    "url": "https://github.com/DenBraun/Onto2D/issues"
  },
  "homepage": "https://github.com/DenBraun/Onto2D/tree/main/packages/engine#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./presentation": {
      "types": "./src/presentation.d.ts",
      "import": "./src/presentation.js"
    }
  },
  "dependencies": {
    "@onto2d/kernel": "0.1.0",
    "@onto2d/model-pack": "0.1.0",
    "@onto2d/view": "0.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
