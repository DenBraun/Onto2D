{
  "name": "@onto2d/cli",
  "version": "0.1.0",
  "description": "Read-only command-line verification and inspection for local Onto2D Model Packs.",
  "type": "module",
  "types": "./src/index.d.ts",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DenBraun/Onto2D.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/DenBraun/Onto2D/issues"
  },
  "homepage": "https://github.com/DenBraun/Onto2D/tree/main/packages/cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "bin": {
    "onto2d": "./src/bin.js"
  },
  "dependencies": {
    "@onto2d/engine": "0.1.0",
    "@onto2d/model-pack": "0.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
