  },
  "files": [
    "src",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DenBraun/Onto2D.git",
    "directory": "packages/schemas"
  },
  "bugs": {
    "url": "https://github.com/DenBraun/Onto2D/issues"
  },
  "homepage": "https://github.com/DenBraun/Onto2D/tree/main/packages/schemas#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
