{
  "name": "@onto2d/schemas",
  "version": "0.1.0",
  "description": "Versioned JSON Schema contracts for Onto2D kernel artifacts.",
  "type": "module",
  "types": "./src/index.d.ts",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
