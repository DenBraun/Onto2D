{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-candidate-filter-evaluation.schema.json",
  "title": "Onto2D Package Candidate Filter Evaluation",
  "type": "object",
  "required": [
    "schemaVersion",
    "evaluator",
    "packageId",
    "rulesHash",
    "bindingHash",
    "formation",
    "predicateEvaluations",
    "verdict",
    "counts",
    "passedPredicates",
    "failedPredicates",
    "indeterminatePredicates",
    "filterHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "evaluator": { "const": "package-candidate-filter-evaluator-v20" },
    "packageId": { "$ref": "#/$defs/hash" },
    "rulesHash": { "$ref": "#/$defs/hash" },
    "bindingHash": { "$ref": "#/$defs/hash" },
    "formation": {
      "type": "object",
      "required": [
        "targetDepth",
        "depthBasis",
        "sourcePopulationHash",
        "candidate",
        "constituents"
      ],
      "properties": {
        "targetDepth": { "const": 1 },
        "depthBasis": { "$ref": "#/$defs/hash" },
        "sourcePopulationHash": { "$ref": "#/$defs/hash" },
        "candidate": {
          "allOf": [
            { "$ref": "candidate.schema.json" },
            {
              "properties": {
                "domain": { "enum": ["element-exact", "profile-quotient"] }
              }
            }
          ]
        },
        "constituents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/constituent" }
        }
      },
      "additionalProperties": false
    },
    "predicateEvaluations": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/predicateEvaluation" }
    },
    "verdict": {
      "enum": ["eligible", "predicate-rejected", "filter-indeterminate"]
    },
    "counts": {
      "type": "object",
      "required": ["evaluated", "passed", "failed", "indeterminate"],
      "properties": {
        "evaluated": { "$ref": "#/$defs/index" },
        "passed": { "$ref": "#/$defs/index" },
        "failed": { "$ref": "#/$defs/index" },
        "indeterminate": { "$ref": "#/$defs/index" }
      },
      "additionalProperties": false
    },
    "passedPredicates": { "$ref": "#/$defs/stringSet" },
    "failedPredicates": { "$ref": "#/$defs/stringSet" },
    "indeterminatePredicates": { "$ref": "#/$defs/stringSet" },
    "filterHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "normalizedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:\\S|\\S(?:.*\\S)?)$"
    },
    "stringSet": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/normalizedString" }
    },
    "constituent": {
      "type": "object",
      "required": [
        "canonicalNode",
        "sourceRef",
        "elementId",
        "profileHash",
        "resolution",
        "representativePolicy",
        "profileClassMembers"
      ],
      "properties": {
        "canonicalNode": { "$ref": "#/$defs/index" },
        "sourceRef": { "$ref": "#/$defs/hash" },
        "elementId": { "$ref": "#/$defs/hash" },
        "profileHash": { "$ref": "#/$defs/hash" },
        "resolution": { "enum": ["element-exact", "profile-representative"] },
        "representativePolicy": {
          "enum": [
            "direct-element-reference-v1",
            "lexicographically-smallest-element-id-v1"
          ]
        },
        "profileClassMembers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hash" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "resolution": { "const": "element-exact" } },
            "required": ["resolution"]
          },
          "then": {
            "properties": {
              "representativePolicy": { "const": "direct-element-reference-v1" }
            }
          },
          "else": {
            "properties": {
              "representativePolicy": {
                "const": "lexicographically-smallest-element-id-v1"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "predicateEvaluation": {
      "type": "object",
      "required": ["predicateId", "phase", "claimRefs", "evaluation"],
      "properties": {
        "predicateId": { "$ref": "#/$defs/normalizedString" },
        "phase": { "enum": ["formation", "maintenance", "termination"] },
        "claimRefs": { "$ref": "#/$defs/stringSet" },
        "evaluation": { "$ref": "predicate-local-evaluation.schema.json" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
