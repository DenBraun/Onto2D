{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-level-explanation-index.schema.json",
  "title": "Onto2D Verified Package Level Explanation Index",
  "type": "object",
  "required": [
    "schemaVersion",
    "indexer",
    "scope",
    "packageId",
    "rulesHash",
    "depthBasis",
    "runHash",
    "levelHash",
    "targetDepth",
    "countingDomain",
    "sourcePopulationHash",
    "artifactHashes",
    "entries",
    "counts",
    "indexHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "indexer": { "const": "package-level-explanation-indexer-v1" },
    "scope": { "const": "complete-verified-level-candidate-lineage-v1" },
    "packageId": { "$ref": "#/$defs/hash" },
    "rulesHash": { "$ref": "#/$defs/hash" },
    "depthBasis": { "$ref": "#/$defs/hash" },
    "runHash": { "$ref": "#/$defs/hash" },
    "levelHash": { "$ref": "#/$defs/hash" },
    "targetDepth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "countingDomain": { "enum": ["element-exact", "profile-quotient"] },
    "sourcePopulationHash": { "$ref": "#/$defs/hash" },
    "artifactHashes": { "$ref": "#/$defs/artifactHashes" },
    "entries": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/entry" }
    },
    "counts": { "$ref": "#/$defs/counts" },
    "indexHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "artifactHashes": {
      "type": "object",
      "required": [
        "censusHash",
        "admissionHash",
        "formationSetHash",
        "profileSetHash",
        "populationHash"
      ],
      "properties": {
        "censusHash": { "$ref": "#/$defs/hash" },
        "admissionHash": { "$ref": "#/$defs/hash" },
        "formationSetHash": { "$ref": "#/$defs/hash" },
        "profileSetHash": { "$ref": "#/$defs/hash" },
        "populationHash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "derivedElementLink": {
      "type": "object",
      "required": ["element", "primaryFormationHash", "derivation"],
      "properties": {
        "element": {
          "allOf": [
            { "$ref": "element.schema.json" },
            { "properties": { "kind": { "const": "derived" } } }
          ]
        },
        "primaryFormationHash": { "$ref": "#/$defs/hash" },
        "derivation": {
          "$ref": "package-derived-depth-population.schema.json#/$defs/derivation"
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "candidateId",
        "filter",
        "admission",
        "formation",
        "profile",
        "derivedElements"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/hash" },
        "filter": {
          "oneOf": [
            { "$ref": "package-candidate-filter-evaluation.schema.json" },
            { "$ref": "package-depth-candidate-filter-evaluation.schema.json" }
          ]
        },
        "admission": {
          "$ref": "package-selector-admission.schema.json#/$defs/decision"
        },
        "formation": {
          "oneOf": [
            { "$ref": "package-selected-formations.schema.json#/$defs/formation" },
            { "type": "null" }
          ]
        },
        "profile": {
          "oneOf": [
            { "$ref": "package-derived-profiles.schema.json#/$defs/result" },
            { "type": "null" }
          ]
        },
        "derivedElements": {
          "type": "array",
          "maxItems": 1000000,
          "items": { "$ref": "#/$defs/derivedElementLink" }
        }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": [
        "candidates",
        "selectedCandidates",
        "formations",
        "materializedProfiles",
        "indeterminateProfiles",
        "derivedElementLinks",
        "distinctDerivedElements"
      ],
      "properties": {
        "candidates": { "$ref": "#/$defs/count" },
        "selectedCandidates": { "$ref": "#/$defs/count" },
        "formations": { "$ref": "#/$defs/count" },
        "materializedProfiles": { "$ref": "#/$defs/count" },
        "indeterminateProfiles": { "$ref": "#/$defs/count" },
        "derivedElementLinks": { "$ref": "#/$defs/count" },
        "distinctDerivedElements": { "$ref": "#/$defs/count" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
