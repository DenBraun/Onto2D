{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/predicate.schema.json",
  "title": "Onto2D Predicate",
  "type": "object",
  "required": ["id", "phase", "monotoneViolation", "referencesDepth", "expr", "explain", "claimRefs"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["formation", "maintenance", "termination"] },
    "monotoneViolation": { "type": "boolean" },
    "referencesDepth": { "enum": ["below", "self"] },
    "expr": { "$ref": "boolean-expression.schema.json" },
    "explain": {
      "type": "object",
      "required": ["pass", "fail", "indeterminate"],
      "properties": {
        "pass": { "type": "string", "minLength": 1 },
        "fail": { "type": "string", "minLength": 1 },
        "indeterminate": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "claimRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
