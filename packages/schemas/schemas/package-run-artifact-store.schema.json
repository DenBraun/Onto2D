{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-run-artifact-store.schema.json",
  "title": "Onto2D Verified Package Run Artifact Store",
  "type": "object",
  "required": [
    "schemaVersion",
    "indexer",
    "scope",
    "bundles",
    "runIndex",
    "counts",
    "storeHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "indexer": { "const": "package-run-artifact-store-v1" },
    "scope": { "const": "externally-bound-verified-run-bundle-index-v1" },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "package-run-artifact-bundle.schema.json" }
    },
    "runIndex": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6400,
      "items": {
        "type": "object",
        "required": [
          "runHash",
          "bundleHash",
          "targetDepth",
          "levelHash",
          "resultCensusHash",
          "explanationIndexHash"
        ],
        "properties": {
          "runHash": { "$ref": "#/$defs/hash" },
          "bundleHash": { "$ref": "#/$defs/hash" },
          "targetDepth": { "$ref": "#/$defs/depth" },
          "levelHash": { "$ref": "#/$defs/hash" },
          "resultCensusHash": { "$ref": "#/$defs/hash" },
          "explanationIndexHash": { "$ref": "#/$defs/hash" }
        },
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "required": ["bundles", "runs", "levels", "artifacts"],
      "properties": {
        "bundles": { "$ref": "#/$defs/count" },
        "runs": { "$ref": "#/$defs/count" },
        "levels": { "$ref": "#/$defs/count" },
        "artifacts": { "$ref": "#/$defs/count" }
      },
      "additionalProperties": false
    },
    "storeHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "additionalProperties": false
}
