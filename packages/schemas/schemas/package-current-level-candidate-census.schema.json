{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-current-level-candidate-census.schema.json",
  "title": "Onto2D Complete Current-Level Round Census",
  "type": "object",
  "required": [
    "schemaVersion",
    "evaluator",
    "scope",
    "packageId",
    "rulesHash",
    "bindingHash",
    "countingDomain",
    "targetDepth",
    "round",
    "sourcePopulationHash",
    "dominanceThreshold",
    "indeterminateThreshold",
    "generation",
    "candidateEvaluations",
    "counts",
    "booleanSelectivity",
    "indeterminateRatio",
    "interpretation",
    "census",
    "censusHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "evaluator": {
      "const": "package-current-level-candidate-census-evaluator-v1"
    },
    "scope": {
      "const": "complete-current-level-round-local-filter-census-v1"
    },
    "packageId": { "$ref": "#/$defs/hash" },
    "rulesHash": { "$ref": "#/$defs/hash" },
    "bindingHash": { "$ref": "#/$defs/hash" },
    "countingDomain": { "enum": ["profile-quotient", "element-exact"] },
    "targetDepth": { "type": "integer", "minimum": 1, "maximum": 64 },
    "round": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "sourcePopulationHash": { "$ref": "#/$defs/hash" },
    "dominanceThreshold": { "const": 0.9 },
    "indeterminateThreshold": { "$ref": "#/$defs/ratio" },
    "generation": {
      "allOf": [
        {
          "$ref": "package-current-level-candidate-enumeration-result.schema.json"
        },
        {
          "properties": {
            "enumeration": {
              "properties": {
                "status": { "const": "complete" },
                "interpretable": { "const": true },
                "candidateStore": {
                  "properties": { "status": { "const": "complete" } }
                }
              }
            }
          }
        }
      ]
    },
    "candidateEvaluations": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "$ref": "package-current-level-candidate-filter-evaluation.schema.json"
      }
    },
    "counts": { "$ref": "package-depth-candidate-census.schema.json#/$defs/counts" },
    "booleanSelectivity": { "$ref": "#/$defs/ratioOrNull" },
    "indeterminateRatio": { "$ref": "#/$defs/ratioOrNull" },
    "interpretation": {
      "$ref": "package-depth-candidate-census.schema.json#/$defs/interpretation"
    },
    "census": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "package-candidate-census.schema.json#/$defs/predicateCensus"
      }
    },
    "censusHash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "interpretation": {
            "properties": { "status": { "const": "empty" } },
            "required": ["status"]
          }
        },
        "required": ["interpretation"]
      },
      "then": {
        "properties": {
          "candidateEvaluations": { "maxItems": 0 },
          "booleanSelectivity": { "type": "null" },
          "indeterminateRatio": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "interpretation": {
            "properties": { "status": { "enum": ["valid", "indeterminate"] } },
            "required": ["status"]
          }
        },
        "required": ["interpretation"]
      },
      "then": {
        "properties": {
          "booleanSelectivity": { "type": "number" },
          "indeterminateRatio": { "type": "number" }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "ratioOrNull": {
      "oneOf": [{ "$ref": "#/$defs/ratio" }, { "type": "null" }]
    }
  },
  "additionalProperties": false
}
