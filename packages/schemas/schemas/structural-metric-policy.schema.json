{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/structural-metric-policy.schema.json",
  "title": "Structural Metric Policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "const": "unit-v1"
    },
    "version": {
      "const": "1"
    },
    "vertexWeight": {
      "const": 1
    },
    "edgeWeight": {
      "const": 1
    },
    "edgeLength": {
      "const": 1
    },
    "sourceWeightUsage": {
      "const": "provenance-only"
    }
  },
  "required": [
    "id",
    "version",
    "vertexWeight",
    "edgeWeight",
    "edgeLength",
    "sourceWeightUsage"
  ]
}
