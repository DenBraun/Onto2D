{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/candidate-store-snapshot.schema.json",
  "title": "Onto2D Candidate Store Snapshot",
  "type": "object",
  "required": ["schemaVersion", "status", "interpretable", "domain", "canonicalization", "candidates", "counts", "budget"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "status": { "enum": ["open", "complete", "budget-exhausted"] },
    "interpretable": { "type": "boolean" },
    "domain": { "enum": ["profile-quotient", "element-exact", "single-candidate"] },
    "canonicalization": {
      "type": "object",
      "required": ["policy", "limits"],
      "properties": {
        "policy": { "$ref": "graph-policy.schema.json" },
        "limits": { "$ref": "#/$defs/canonicalizationLimits" }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/record" }
    },
    "counts": {
      "type": "object",
      "required": ["attemptedCandidates", "uniqueCandidates", "duplicateCandidates", "excludedCandidates"],
      "properties": {
        "attemptedCandidates": { "type": "integer", "minimum": 0 },
        "uniqueCandidates": { "type": "integer", "minimum": 0 },
        "duplicateCandidates": { "type": "integer", "minimum": 0 },
        "excludedCandidates": { "type": "integer", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["maxCandidates", "exhausted"],
      "properties": {
        "maxCandidates": { "type": "integer", "minimum": 1 },
        "exhausted": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/exhaustion" }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "open" } }, "required": ["status"] },
      "then": {
        "properties": {
          "interpretable": { "const": false },
          "budget": { "properties": { "exhausted": { "type": "null" } } }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "complete" } }, "required": ["status"] },
      "then": {
        "properties": {
          "interpretable": { "const": true },
          "budget": { "properties": { "exhausted": { "type": "null" } } }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "budget-exhausted" } }, "required": ["status"] },
      "then": {
        "properties": {
          "interpretable": { "const": false },
          "budget": { "properties": { "exhausted": { "$ref": "#/$defs/exhaustion" } } }
        }
      }
    }
  ],
  "$defs": {
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "canonicalizationLimits": {
      "type": "object",
      "required": ["maxNodes", "maxEdges", "maxSearchStates"],
      "properties": {
        "maxNodes": { "type": "integer", "minimum": 1, "maximum": 6 },
        "maxEdges": { "type": "integer", "minimum": 0 },
        "maxSearchStates": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "canonicalForm": {
      "type": "object",
      "required": ["schemaVersion", "bytesBase64", "hash"],
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1 },
        "bytesBase64": { "type": "string", "contentEncoding": "base64" },
        "hash": { "$ref": "#/$defs/contentHash" }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": ["candidateId", "skeletonId", "candidate", "canonicalForm", "duplicateCount"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/contentHash" },
        "skeletonId": { "$ref": "#/$defs/contentHash" },
        "candidate": { "$ref": "candidate.schema.json" },
        "canonicalForm": { "$ref": "#/$defs/canonicalForm" },
        "duplicateCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "exhaustion": {
      "type": "object",
      "required": ["budget", "used", "maximum", "firstExcludedCandidateId", "attemptedCandidates"],
      "properties": {
        "budget": { "const": "maxCandidates" },
        "used": { "type": "integer", "minimum": 0 },
        "maximum": { "type": "integer", "minimum": 1 },
        "firstExcludedCandidateId": { "$ref": "#/$defs/contentHash" },
        "attemptedCandidates": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
