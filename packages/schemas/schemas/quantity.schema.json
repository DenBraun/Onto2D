{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/quantity.schema.json",
  "title": "Onto2D Quantity",
  "type": "object",
  "required": ["value", "unit", "tolerance", "semantic", "provenance"],
  "properties": {
    "value": { "type": "number" },
    "unit": { "$ref": "#/$defs/unit" },
    "tolerance": {
      "type": "object",
      "properties": {
        "absolute": { "type": "number", "minimum": 0 },
        "relative": { "type": "number", "minimum": 0 }
      },
      "anyOf": [
        { "required": ["absolute"] },
        { "required": ["relative"] }
      ],
      "additionalProperties": false
    },
    "semantic": { "$ref": "#/$defs/normalizedString" },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "evidence"],
          "properties": {
            "kind": { "const": "declared" },
            "evidence": { "$ref": "#/$defs/evidenceIds" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "method", "evidence"],
          "properties": {
            "kind": { "const": "computed" },
            "method": { "$ref": "#/$defs/normalizedString" },
            "evidence": { "$ref": "#/$defs/evidenceIds" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "source", "method", "evidence"],
          "properties": {
            "kind": { "const": "oracle" },
            "source": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "method": { "$ref": "#/$defs/normalizedString" },
            "evidence": { "$ref": "#/$defs/evidenceIds" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$defs": {
    "normalizedString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\S|\\S(?:.*\\S)?)$"
    },
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/normalizedString" }
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?:1|[A-Za-z][A-Za-z0-9]*)(?:\\^-?[1-9][0-9]*)?(?:[*/](?:1|[A-Za-z][A-Za-z0-9]*)(?:\\^-?[1-9][0-9]*)?)*$",
      "$comment": "Runtime validation additionally restricts symbols, prefixes, factors, and exponents under si-multiplicative-v1."
    }
  },
  "additionalProperties": false
}
