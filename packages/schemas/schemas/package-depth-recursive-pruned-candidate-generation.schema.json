{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-depth-recursive-pruned-candidate-generation.schema.json",
  "title": "Onto2D Depth-Aware Audited Recursive-Pruning Candidate Generation",
  "type": "object",
  "required": [
    "schemaVersion",
    "generator",
    "packageId",
    "rulesHash",
    "bindingHash",
    "runConfigHash",
    "targetDepth",
    "sourcePopulationHash",
    "canonicalAuditHash",
    "frontierAuditHash",
    "binding",
    "enumeration",
    "profileComposition",
    "pruning",
    "conformance",
    "generationHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "generator": {
      "const": "package-depth-recursive-pruned-candidate-generator-v1"
    },
    "packageId": { "$ref": "#/$defs/hash" },
    "rulesHash": { "$ref": "#/$defs/hash" },
    "bindingHash": { "$ref": "#/$defs/hash" },
    "runConfigHash": { "$ref": "#/$defs/hash" },
    "targetDepth": { "$ref": "#/$defs/depth" },
    "sourcePopulationHash": { "$ref": "#/$defs/hash" },
    "canonicalAuditHash": { "$ref": "#/$defs/hash" },
    "frontierAuditHash": { "$ref": "#/$defs/hash" },
    "binding": { "$ref": "package-depth-candidate-binding.schema.json" },
    "enumeration": {
      "allOf": [
        { "$ref": "candidate-enumeration-result.schema.json" },
        {
          "properties": {
            "status": { "const": "complete" },
            "interpretable": { "const": true }
          }
        }
      ]
    },
    "profileComposition": {
      "$ref": "package-profile-composition.schema.json"
    },
    "pruning": { "$ref": "#/$defs/pruning" },
    "conformance": {
      "$ref": "package-recursive-pruned-candidate-generation.schema.json#/$defs/conformance"
    },
    "generationHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:\\S|\\S(?:.*\\S)?)$"
    },
    "depth": { "type": "integer", "minimum": 1, "maximum": 64 },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pruning": {
      "type": "object",
      "required": [
        "strategy",
        "transcriptHash",
        "frontierAuthorizedPredicateIds",
        "preAdmissionAuthorizedPredicateIds",
        "prunedFrontiers",
        "counts"
      ],
      "properties": {
        "strategy": { "const": "audited-edge-group-subtree-pruning-v1" },
        "transcriptHash": { "$ref": "#/$defs/hash" },
        "frontierAuthorizedPredicateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "preAdmissionAuthorizedPredicateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "prunedFrontiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/prunedFrontier" }
        },
        "counts": {
          "$ref": "package-recursive-pruned-candidate-generation.schema.json#/$defs/pruningCounts"
        }
      },
      "additionalProperties": false
    },
    "prunedFrontier": {
      "type": "object",
      "required": [
        "frontierOrdinal", "partialGraph", "decision", "profileExtension"
      ],
      "properties": {
        "frontierOrdinal": { "$ref": "#/$defs/count" },
        "partialGraph": {
          "allOf": [
            { "$ref": "partial-predicate-graph.schema.json" },
            { "properties": { "nodesComplete": { "const": true } } }
          ]
        },
        "decision": {
          "$ref": "package-depth-generator-frontier-decision.schema.json"
        },
        "profileExtension": {
          "$ref": "package-generator-frontier-audit.schema.json#/$defs/profileExtensionFrontier"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
