{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/decimal-unrounded-accumulation.schema.json",
  "title": "Onto2D Unrounded Decimal Accumulation",
  "type": "object",
  "required": ["arithmetic", "algorithm", "termCount", "exact", "value"],
  "properties": {
    "arithmetic": { "const": "decimal-rational-v1" },
    "algorithm": { "enum": ["exact-decimal", "compensated-binary64"] },
    "termCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "exact": { "type": "boolean" },
    "value": { "$ref": "decimal-value.schema.json" }
  },
  "allOf": [
    {
      "if": { "properties": { "algorithm": { "const": "exact-decimal" } } },
      "then": { "properties": { "exact": { "const": true } } },
      "else": { "properties": { "exact": { "const": false } } }
    }
  ],
  "additionalProperties": false
}
