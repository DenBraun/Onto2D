{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-null-model-baseline.schema.json",
  "title": "Onto2D Per-Model Null Baseline",
  "type": "object",
  "required": [
    "schemaVersion",
    "evaluator",
    "scope",
    "trialSelectionsHash",
    "packageId",
    "rulesHash",
    "runConfigHash",
    "bindingHash",
    "censusHash",
    "carrierHash",
    "countingDomain",
    "distributionPolicy",
    "observed",
    "models",
    "counts",
    "status",
    "interpretation",
    "baselineHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "evaluator": { "const": "package-null-model-baseline-v1" },
    "scope": { "const": "per-model-complete-trial-metric-distributions-v1" },
    "trialSelectionsHash": { "$ref": "#/$defs/hash" },
    "packageId": { "$ref": "#/$defs/hash" },
    "rulesHash": { "$ref": "#/$defs/hash" },
    "runConfigHash": { "$ref": "#/$defs/hash" },
    "bindingHash": { "$ref": "#/$defs/hash" },
    "censusHash": { "$ref": "#/$defs/hash" },
    "carrierHash": { "$ref": "#/$defs/hash" },
    "countingDomain": { "enum": ["profile-quotient", "element-exact"] },
    "distributionPolicy": { "$ref": "#/$defs/distributionPolicy" },
    "observed": { "$ref": "#/$defs/observed" },
    "models": {
      "type": "object",
      "maxProperties": 3,
      "propertyNames": {
        "enum": ["role-shuffle", "degree-rewire", "uniform"]
      },
      "additionalProperties": { "$ref": "#/$defs/modelBaseline" }
    },
    "counts": { "$ref": "#/$defs/counts" },
    "status": { "enum": ["complete", "not-run", "indeterminate"] },
    "interpretation": { "$ref": "#/$defs/interpretation" },
    "baselineHash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "not-run" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "models": { "maxProperties": 0 },
          "counts": {
            "properties": {
              "models": { "const": 0 },
              "completeModels": { "const": 0 },
              "indeterminateModels": { "const": 0 },
              "trials": { "const": 0 }
            }
          },
          "interpretation": {
            "properties": { "status": { "const": "not-run" } },
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "complete" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "models": {
            "minProperties": 1,
            "additionalProperties": {
              "properties": { "status": { "const": "complete" } },
              "required": ["status"]
            }
          },
          "counts": {
            "properties": {
              "models": { "minimum": 1 },
              "indeterminateModels": { "const": 0 },
              "trials": { "minimum": 1 }
            }
          },
          "interpretation": {
            "properties": { "status": { "const": "complete" } },
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "indeterminate" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "models": { "minProperties": 1 },
          "counts": {
            "properties": {
              "models": { "minimum": 1 },
              "indeterminateModels": { "minimum": 1 },
              "trials": { "minimum": 1 }
            }
          },
          "interpretation": {
            "properties": { "status": { "const": "indeterminate" } },
            "required": ["status"]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "normalizedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:\\S|\\S(?:.*\\S)?)$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ratioOrNull": {
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "null" }
      ]
    },
    "numberOrNull": {
      "oneOf": [{ "type": "number" }, { "type": "null" }]
    },
    "reasonSet": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/normalizedString" }
    },
    "metricState": {
      "type": "object",
      "required": ["value", "status", "reasons"],
      "properties": {
        "value": { "$ref": "#/$defs/ratioOrNull" },
        "status": {
          "enum": ["valid", "empty", "indeterminate", "fragile", "not-applicable"]
        },
        "reasons": { "$ref": "#/$defs/reasonSet" }
      },
      "additionalProperties": false
    },
    "observed": {
      "type": "object",
      "required": ["censusHash", "admissionHash", "metrics"],
      "properties": {
        "censusHash": { "$ref": "#/$defs/hash" },
        "admissionHash": { "$ref": "#/$defs/hash" },
        "metrics": {
          "type": "object",
          "required": [
            "booleanSelectivity",
            "variationalSelectivity",
            "selectionRetention",
            "overallRetention",
            "indeterminateRatio"
          ],
          "properties": {
            "booleanSelectivity": { "$ref": "#/$defs/metricState" },
            "variationalSelectivity": {
              "type": "object",
              "maxProperties": 10000,
              "additionalProperties": { "$ref": "#/$defs/metricState" }
            },
            "selectionRetention": { "$ref": "#/$defs/metricState" },
            "overallRetention": { "$ref": "#/$defs/metricState" },
            "indeterminateRatio": { "$ref": "#/$defs/metricState" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "distributionPolicy": {
      "type": "object",
      "required": [
        "pooling",
        "sampleOrder",
        "mean",
        "standardDeviation",
        "standardizedEffect",
        "missingSample",
        "zeroVariance"
      ],
      "properties": {
        "pooling": {
          "const": "never-across-models-carriers-or-ontology-gates-v1"
        },
        "sampleOrder": { "const": "trial-id-v1" },
        "mean": { "const": "compensated-binary64-fixed-order-v1" },
        "standardDeviation": {
          "const": "sample-n-minus-one-compensated-binary64-v1"
        },
        "standardizedEffect": {
          "const": "observed-minus-null-mean-over-sample-sd-v1"
        },
        "missingSample": {
          "const": "invalidate-without-denominator-reduction-v1"
        },
        "zeroVariance": {
          "const": "null-z-with-observed-constant-relation-v1"
        }
      },
      "additionalProperties": false
    },
    "note": {
      "enum": [
        "sample-metric-unavailable",
        "sample-standard-deviation-requires-two-runs",
        "zero-variance-observed-unavailable",
        "zero-variance-observed-equals-null-constant",
        "zero-variance-observed-differs-from-null-constant",
        "coefficient-sensitivity-fragile",
        "observed-metric-unavailable"
      ]
    },
    "distribution": {
      "type": "object",
      "required": [
        "model",
        "metricId",
        "expectedSamples",
        "availableSamples",
        "mean",
        "sd",
        "z",
        "constantRelation",
        "status",
        "notes",
        "sampleTrialIds",
        "distributionHash"
      ],
      "properties": {
        "model": { "enum": ["role-shuffle", "degree-rewire", "uniform"] },
        "metricId": { "$ref": "#/$defs/normalizedString" },
        "expectedSamples": { "$ref": "#/$defs/count" },
        "availableSamples": { "$ref": "#/$defs/count" },
        "mean": { "$ref": "#/$defs/ratioOrNull" },
        "sd": { "$ref": "#/$defs/ratioOrNull" },
        "z": { "$ref": "#/$defs/numberOrNull" },
        "constantRelation": {
          "oneOf": [
            { "enum": ["equal", "different", "observed-unavailable"] },
            { "type": "null" }
          ]
        },
        "status": { "enum": ["complete", "fragile", "indeterminate"] },
        "notes": {
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/note" }
        },
        "sampleTrialIds": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hash" }
        },
        "distributionHash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "modelBaseline": {
      "type": "object",
      "required": ["status", "runs", "metrics", "samplesArtifact", "notes"],
      "properties": {
        "status": { "enum": ["complete", "indeterminate"] },
        "runs": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "metrics": {
          "type": "object",
          "required": [
            "booleanSelectivity",
            "variationalSelectivity",
            "selectionRetention",
            "overallRetention",
            "indeterminateRatio"
          ],
          "properties": {
            "booleanSelectivity": { "$ref": "#/$defs/distribution" },
            "variationalSelectivity": {
              "type": "object",
              "maxProperties": 10000,
              "additionalProperties": { "$ref": "#/$defs/distribution" }
            },
            "selectionRetention": { "$ref": "#/$defs/distribution" },
            "overallRetention": { "$ref": "#/$defs/distribution" },
            "indeterminateRatio": { "$ref": "#/$defs/distribution" }
          },
          "additionalProperties": false
        },
        "samplesArtifact": { "$ref": "#/$defs/hash" },
        "notes": {
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/note" }
        }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["models", "completeModels", "indeterminateModels", "trials"],
      "properties": {
        "models": { "type": "integer", "minimum": 0, "maximum": 3 },
        "completeModels": { "type": "integer", "minimum": 0, "maximum": 3 },
        "indeterminateModels": { "type": "integer", "minimum": 0, "maximum": 3 },
        "trials": { "$ref": "#/$defs/count" }
      },
      "additionalProperties": false
    },
    "interpretation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "reasons"],
          "properties": {
            "status": { "const": "complete" },
            "reasons": { "const": [] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "reasons"],
          "properties": {
            "status": { "const": "not-run" },
            "reasons": { "const": ["null-models-disabled"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "reasons"],
          "properties": {
            "status": { "const": "indeterminate" },
            "reasons": {
              "const": ["one-or-more-model-metrics-uninterpretable"]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
