{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-run-artifact-directory-receipt.schema.json",
  "title": "Onto2D Package Run Artifact Directory Receipt",
  "type": "object",
  "required": [
    "schemaVersion",
    "writer",
    "status",
    "directory",
    "bundleHash",
    "runHash",
    "targetDepth",
    "bundleRef",
    "artifacts",
    "counts"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "writer": { "const": "package-run-artifact-directory-v1" },
    "status": { "enum": ["written", "already-present", "verified"] },
    "directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768,
      "pattern": "^(?:\\S|\\S(?:.*\\S)?)$"
    },
    "bundleHash": { "$ref": "#/$defs/hash" },
    "runHash": { "$ref": "#/$defs/hash" },
    "targetDepth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "bundleRef": { "$ref": "artifact-ref.schema.json" },
    "artifacts": {
      "type": "array",
      "minItems": 19,
      "maxItems": 4096,
      "items": {
        "$ref": "package-run-artifact-bundle.schema.json#/$defs/artifact"
      }
    },
    "counts": {
      "type": "object",
      "required": ["files", "artifacts", "bytes"],
      "properties": {
        "files": { "$ref": "#/$defs/count" },
        "artifacts": { "$ref": "#/$defs/count" },
        "bytes": { "$ref": "#/$defs/count" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "additionalProperties": false
}
