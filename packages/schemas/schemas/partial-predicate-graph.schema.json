{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/partial-predicate-graph.schema.json",
  "title": "Onto2D Partial Predicate Graph",
  "type": "object",
  "required": ["domain", "nodes", "edges", "nodesComplete"],
  "properties": {
    "domain": { "enum": ["profile-quotient", "element-exact", "single-candidate"] },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "candidate.schema.json#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "candidate.schema.json#/$defs/edge" }
    },
    "nodesComplete": { "type": "boolean" }
  },
  "additionalProperties": false
}
