{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-selector-admission.schema.json",
  "title": "Onto2D Complete Multi-Selector Admission",
  "type": "object",
  "required": [
    "schemaVersion",
    "admitter",
    "scope",
    "packageId",
    "rulesHash",
    "bindingHash",
    "censusHash",
    "countingDomain",
    "sourcePopulationHash",
    "selectorOrder",
    "admissionPolicy",
    "selectorExecutions",
    "decisions",
    "selectorCensus",
    "selectedCandidateIds",
    "counts",
    "selectionRetention",
    "overallRetention",
    "indeterminateRatio",
    "status",
    "interpretation",
    "admissionHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "admitter": { "const": "package-selector-admission-v1" },
    "scope": { "const": "complete-local-census-all-declared-selectors-v1" },
    "packageId": { "$ref": "#/$defs/hash" },
    "rulesHash": { "$ref": "#/$defs/hash" },
    "bindingHash": { "$ref": "#/$defs/hash" },
    "censusHash": { "$ref": "#/$defs/hash" },
    "countingDomain": { "enum": ["profile-quotient", "element-exact"] },
    "sourcePopulationHash": { "$ref": "#/$defs/hash" },
    "selectorOrder": { "$ref": "#/$defs/idSet" },
    "admissionPolicy": { "$ref": "#/$defs/admissionPolicy" },
    "selectorExecutions": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/selectorExecution" }
    },
    "decisions": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/decision" }
    },
    "selectorCensus": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/selectorCensus" }
    },
    "selectedCandidateIds": { "$ref": "#/$defs/hashSet" },
    "counts": { "$ref": "#/$defs/counts" },
    "selectionRetention": { "$ref": "#/$defs/ratioOrNull" },
    "overallRetention": { "$ref": "#/$defs/ratioOrNull" },
    "indeterminateRatio": { "$ref": "#/$defs/ratioOrNull" },
    "status": { "enum": ["complete", "empty", "indeterminate"] },
    "interpretation": { "$ref": "#/$defs/interpretation" },
    "admissionHash": { "$ref": "#/$defs/hash" }
  },
  "oneOf": [
    {
      "properties": {
        "status": { "const": "complete" },
        "interpretation": {
          "properties": {
            "status": { "const": "complete" },
            "reasons": { "maxItems": 0 }
          }
        },
        "counts": {
          "properties": { "evaluatedCandidates": { "minimum": 1 } }
        },
        "selectionRetention": {
          "oneOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "overallRetention": { "type": "number" },
        "indeterminateRatio": { "type": "number" }
      }
    },
    {
      "properties": {
        "status": { "const": "empty" },
        "interpretation": {
          "properties": {
            "status": { "const": "empty" },
            "reasons": {
              "prefixItems": [{ "const": "no-evaluated-candidates" }],
              "minItems": 1,
              "maxItems": 1
            }
          }
        },
        "decisions": { "maxItems": 0 },
        "selectedCandidateIds": { "maxItems": 0 },
        "counts": {
          "properties": {
            "evaluatedCandidates": { "const": 0 },
            "predicateRejected": { "const": 0 },
            "filterIndeterminate": { "const": 0 },
            "eligibleCandidates": { "const": 0 },
            "selectorExcluded": { "const": 0 },
            "selectionIndeterminate": { "const": 0 },
            "selectedCandidates": { "const": 0 },
            "finalIndeterminate": { "const": 0 }
          }
        },
        "selectionRetention": { "type": "null" },
        "overallRetention": { "type": "null" },
        "indeterminateRatio": { "type": "null" }
      }
    },
    {
      "properties": {
        "status": { "const": "indeterminate" },
        "interpretation": {
          "properties": {
            "status": { "const": "indeterminate" },
            "reasons": {
              "prefixItems": [{
                "const": "indeterminate-ratio-exceeds-threshold"
              }],
              "minItems": 1,
              "maxItems": 1
            }
          }
        },
        "counts": {
          "properties": {
            "evaluatedCandidates": { "minimum": 1 },
            "finalIndeterminate": { "minimum": 1 }
          }
        },
        "overallRetention": { "type": "number" },
        "indeterminateRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "normalizedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:\\S|\\S(?:.*\\S)?)$"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ratioOrNull": {
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "null" }
      ]
    },
    "hashSet": {
      "type": "array",
      "maxItems": 1000000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hash" }
    },
    "idSet": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/normalizedString" }
    },
    "admissionPolicy": {
      "type": "object",
      "required": [
        "selectorOrder",
        "combination",
        "decisionPrecedence",
        "noSelectors",
        "sensitivityEffect"
      ],
      "properties": {
        "selectorOrder": { "const": "normalized-selector-id-v1" },
        "combination": {
          "const": "every-applicable-semantic-extremum-v1"
        },
        "decisionPrecedence": {
          "const": "predicate-rejected-filter-indeterminate-selector-excluded-selection-indeterminate-selected-v1"
        },
        "noSelectors": {
          "const": "identity-admission-without-synthetic-ranking-v1"
        },
        "sensitivityEffect": {
          "const": "interpretation-only-without-base-selection-erasure-v1"
        }
      },
      "additionalProperties": false
    },
    "selectorExecution": {
      "type": "object",
      "required": ["selectorId", "partition", "ranking", "sensitivity"],
      "properties": {
        "selectorId": { "$ref": "#/$defs/normalizedString" },
        "partition": { "$ref": "package-cohort-partition.schema.json" },
        "ranking": { "$ref": "package-selector-ranking.schema.json" },
        "sensitivity": {
          "$ref": "package-selector-sensitivity.schema.json"
        }
      },
      "additionalProperties": false
    },
    "selectorEvaluation": {
      "type": "object",
      "required": [
        "selectorId",
        "cohortId",
        "outcome",
        "functionalEvaluationHash",
        "score",
        "rank",
        "semanticExtrema",
        "rankingHash",
        "sensitivityHash",
        "sensitivityStatus",
        "sensitivityVerdict",
        "claimRefs"
      ],
      "properties": {
        "selectorId": { "$ref": "#/$defs/normalizedString" },
        "cohortId": {
          "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
        },
        "outcome": { "enum": ["selected", "excluded", "indeterminate"] },
        "functionalEvaluationHash": {
          "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
        },
        "score": {
          "oneOf": [{ "$ref": "quantity.schema.json" }, { "type": "null" }]
        },
        "rank": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 1000000 },
            { "type": "null" }
          ]
        },
        "semanticExtrema": { "$ref": "#/$defs/hashSet" },
        "rankingHash": { "$ref": "#/$defs/hash" },
        "sensitivityHash": { "$ref": "#/$defs/hash" },
        "sensitivityStatus": {
          "enum": ["complete", "not-applicable", "indeterminate"]
        },
        "sensitivityVerdict": {
          "oneOf": [
            { "enum": ["robust", "fragile"] },
            { "type": "null" }
          ]
        },
        "claimRefs": { "$ref": "#/$defs/idSet" }
      },
      "oneOf": [
        {
          "properties": {
            "outcome": { "enum": ["selected", "excluded"] },
            "cohortId": { "$ref": "#/$defs/hash" },
            "functionalEvaluationHash": { "$ref": "#/$defs/hash" },
            "score": { "$ref": "quantity.schema.json" },
            "rank": { "type": "integer", "minimum": 1 },
            "semanticExtrema": { "minItems": 1 }
          }
        },
        {
          "properties": {
            "outcome": { "const": "indeterminate" },
            "semanticExtrema": { "maxItems": 0 }
          }
        }
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "candidateId",
        "filterHash",
        "localVerdict",
        "passedPredicateIds",
        "outcome",
        "selectorEvaluations",
        "selectedBy",
        "excludedBy",
        "indeterminateBy"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/hash" },
        "filterHash": { "$ref": "#/$defs/hash" },
        "localVerdict": {
          "enum": ["eligible", "predicate-rejected", "filter-indeterminate"]
        },
        "passedPredicateIds": { "$ref": "#/$defs/idSet" },
        "outcome": {
          "enum": [
            "predicate-rejected",
            "filter-indeterminate",
            "selector-excluded",
            "selection-indeterminate",
            "selected"
          ]
        },
        "selectorEvaluations": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/selectorEvaluation" }
        },
        "selectedBy": { "$ref": "#/$defs/idSet" },
        "excludedBy": { "$ref": "#/$defs/idSet" },
        "indeterminateBy": { "$ref": "#/$defs/idSet" }
      },
      "oneOf": [
        {
          "properties": {
            "localVerdict": { "const": "predicate-rejected" },
            "outcome": { "const": "predicate-rejected" },
            "selectorEvaluations": { "maxItems": 0 },
            "selectedBy": { "maxItems": 0 },
            "excludedBy": { "maxItems": 0 },
            "indeterminateBy": { "maxItems": 0 }
          }
        },
        {
          "properties": {
            "localVerdict": { "const": "filter-indeterminate" },
            "outcome": { "const": "filter-indeterminate" },
            "selectorEvaluations": { "maxItems": 0 },
            "selectedBy": { "maxItems": 0 },
            "excludedBy": { "maxItems": 0 },
            "indeterminateBy": { "maxItems": 0 }
          }
        },
        {
          "properties": {
            "localVerdict": { "const": "eligible" },
            "outcome": { "const": "selector-excluded" },
            "excludedBy": { "minItems": 1 }
          }
        },
        {
          "properties": {
            "localVerdict": { "const": "eligible" },
            "outcome": { "const": "selection-indeterminate" },
            "excludedBy": { "maxItems": 0 },
            "indeterminateBy": { "minItems": 1 }
          }
        },
        {
          "properties": {
            "localVerdict": { "const": "eligible" },
            "outcome": { "const": "selected" },
            "excludedBy": { "maxItems": 0 },
            "indeterminateBy": { "maxItems": 0 }
          }
        }
      ],
      "additionalProperties": false
    },
    "selectorCensus": {
      "type": "object",
      "required": [
        "selectorId",
        "cohortRuleId",
        "rankingHash",
        "sensitivityHash",
        "rankingStatus",
        "sensitivityStatus",
        "sensitivityVerdict",
        "counts",
        "variationalSelectivity",
        "interpretation"
      ],
      "properties": {
        "selectorId": { "$ref": "#/$defs/normalizedString" },
        "cohortRuleId": { "$ref": "#/$defs/normalizedString" },
        "rankingHash": { "$ref": "#/$defs/hash" },
        "sensitivityHash": { "$ref": "#/$defs/hash" },
        "rankingStatus": { "enum": ["ranked", "empty", "indeterminate"] },
        "sensitivityStatus": {
          "enum": ["complete", "not-applicable", "indeterminate"]
        },
        "sensitivityVerdict": {
          "oneOf": [
            { "enum": ["robust", "fragile"] },
            { "type": "null" }
          ]
        },
        "counts": {
          "type": "object",
          "required": ["evaluated", "selected", "excluded", "indeterminate"],
          "properties": {
            "evaluated": { "$ref": "#/$defs/index" },
            "selected": { "$ref": "#/$defs/index" },
            "excluded": { "$ref": "#/$defs/index" },
            "indeterminate": { "$ref": "#/$defs/index" }
          },
          "additionalProperties": false
        },
        "variationalSelectivity": { "$ref": "#/$defs/ratioOrNull" },
        "interpretation": {
          "type": "object",
          "required": ["status", "reasons"],
          "properties": {
            "status": {
              "enum": ["valid", "fragile", "not-applicable", "indeterminate"]
            },
            "reasons": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/normalizedString" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": [
        "evaluatedCandidates",
        "predicateRejected",
        "filterIndeterminate",
        "eligibleCandidates",
        "selectorExcluded",
        "selectionIndeterminate",
        "selectedCandidates",
        "finalIndeterminate"
      ],
      "properties": {
        "evaluatedCandidates": { "$ref": "#/$defs/index" },
        "predicateRejected": { "$ref": "#/$defs/index" },
        "filterIndeterminate": { "$ref": "#/$defs/index" },
        "eligibleCandidates": { "$ref": "#/$defs/index" },
        "selectorExcluded": { "$ref": "#/$defs/index" },
        "selectionIndeterminate": { "$ref": "#/$defs/index" },
        "selectedCandidates": { "$ref": "#/$defs/index" },
        "finalIndeterminate": { "$ref": "#/$defs/index" }
      },
      "additionalProperties": false
    },
    "interpretation": {
      "type": "object",
      "required": ["status", "reasons"],
      "properties": {
        "status": { "enum": ["complete", "empty", "indeterminate"] },
        "reasons": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "no-evaluated-candidates",
              "indeterminate-ratio-exceeds-threshold"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
