{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/history-benchmark-target.schema.json",
  "title": "History Benchmark Target",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unitId",
          "time",
          "label"
        ],
        "properties": {
          "unitId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"
          },
          "time": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "label": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 1,
      "maxItems": 256
    }
  }
}
