{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-depth-generator-frontier-audit.schema.json",
  "title": "Onto2D Depth-Aware Package Generator-Frontier Audit",
  "type": "object",
  "required": [
    "schemaVersion",
    "auditor",
    "scope",
    "packageId",
    "rulesHash",
    "bindingHash",
    "binding",
    "runConfigHash",
    "targetDepth",
    "sourcePopulationHash",
    "canonicalAuditHash",
    "seed",
    "policy",
    "policySupport",
    "samplesPerPredicate",
    "universe",
    "profileExtensionUniverse",
    "results",
    "counts",
    "status",
    "frontierAuditHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "auditor": { "const": "package-depth-generator-frontier-auditor-v1" },
    "scope": { "const": "complete-depth-aware-raw-edge-group-frontiers-v1" },
    "packageId": { "$ref": "#/$defs/hash" },
    "rulesHash": { "$ref": "#/$defs/hash" },
    "bindingHash": { "$ref": "#/$defs/hash" },
    "binding": { "$ref": "package-depth-candidate-binding.schema.json" },
    "runConfigHash": { "$ref": "#/$defs/hash" },
    "targetDepth": { "$ref": "#/$defs/depth" },
    "sourcePopulationHash": { "$ref": "#/$defs/hash" },
    "canonicalAuditHash": { "$ref": "#/$defs/hash" },
    "seed": { "$ref": "#/$defs/id" },
    "policy": {
      "$ref": "package-generator-frontier-audit.schema.json#/$defs/policy"
    },
    "policySupport": { "const": "supported" },
    "samplesPerPredicate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "universe": {
      "$ref": "package-generator-frontier-audit.schema.json#/$defs/universe"
    },
    "profileExtensionUniverse": {
      "allOf": [
        { "$ref": "package-generator-frontier-audit.schema.json#/$defs/profileExtensionUniverse" },
        { "properties": { "kind": { "const": "edge-group" } } }
      ]
    },
    "results": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "package-generator-frontier-audit.schema.json#/$defs/result"
      }
    },
    "counts": {
      "$ref": "package-generator-frontier-audit.schema.json#/$defs/counts"
    },
    "status": {
      "enum": ["not-applicable", "passed", "failed", "indeterminate"]
    },
    "frontierAuditHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:\\S|\\S(?:.*\\S)?)$"
    },
    "depth": { "type": "integer", "minimum": 1, "maximum": 64 }
  },
  "additionalProperties": false
}
