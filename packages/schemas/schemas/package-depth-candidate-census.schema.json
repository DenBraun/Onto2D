{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-depth-candidate-census.schema.json",
  "title": "Onto2D Complete Depth-Aware Local Filter Census",
  "type": "object",
  "required": [
    "schemaVersion",
    "evaluator",
    "scope",
    "packageId",
    "rulesHash",
    "bindingHash",
    "countingDomain",
    "targetDepth",
    "sourcePopulationHash",
    "dominanceThreshold",
    "indeterminateThreshold",
    "generation",
    "candidateEvaluations",
    "counts",
    "booleanSelectivity",
    "indeterminateRatio",
    "interpretation",
    "census",
    "censusHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "evaluator": { "const": "package-depth-candidate-census-evaluator-v1" },
    "scope": { "const": "complete-depth-aware-local-filter-census-v1" },
    "packageId": { "$ref": "#/$defs/hash" },
    "rulesHash": { "$ref": "#/$defs/hash" },
    "bindingHash": { "$ref": "#/$defs/hash" },
    "countingDomain": { "enum": ["profile-quotient", "element-exact"] },
    "targetDepth": { "type": "integer", "minimum": 1, "maximum": 64 },
    "sourcePopulationHash": { "$ref": "#/$defs/hash" },
    "dominanceThreshold": { "const": 0.9 },
    "indeterminateThreshold": { "$ref": "#/$defs/ratio" },
    "generation": {
      "allOf": [
        { "$ref": "package-depth-candidate-enumeration-result.schema.json" },
        {
          "properties": {
            "enumeration": {
              "properties": {
                "status": { "const": "complete" },
                "interpretable": { "const": true },
                "candidateStore": {
                  "properties": { "status": { "const": "complete" } }
                }
              }
            }
          }
        }
      ]
    },
    "candidateEvaluations": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "package-depth-candidate-filter-evaluation.schema.json" }
    },
    "counts": { "$ref": "#/$defs/counts" },
    "booleanSelectivity": { "$ref": "#/$defs/ratioOrNull" },
    "indeterminateRatio": { "$ref": "#/$defs/ratioOrNull" },
    "interpretation": { "$ref": "#/$defs/interpretation" },
    "census": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "package-candidate-census.schema.json#/$defs/predicateCensus"
      }
    },
    "censusHash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "interpretation": {
            "properties": { "status": { "const": "empty" } },
            "required": ["status"]
          }
        },
        "required": ["interpretation"]
      },
      "then": {
        "properties": {
          "candidateEvaluations": { "maxItems": 0 },
          "booleanSelectivity": { "type": "null" },
          "indeterminateRatio": { "type": "null" },
          "counts": {
            "properties": {
              "canonicalCandidates": { "const": 0 },
              "evaluatedCandidates": { "const": 0 },
              "predicateRejected": { "const": 0 },
              "filterIndeterminate": { "const": 0 },
              "eligibleCandidates": { "const": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "interpretation": {
            "properties": { "status": { "const": "valid" } },
            "required": ["status"]
          }
        },
        "required": ["interpretation"]
      },
      "then": {
        "properties": {
          "counts": {
            "properties": { "evaluatedCandidates": { "minimum": 1 } }
          },
          "booleanSelectivity": { "type": "number" },
          "indeterminateRatio": { "type": "number" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "interpretation": {
            "properties": { "status": { "const": "indeterminate" } },
            "required": ["status"]
          }
        },
        "required": ["interpretation"]
      },
      "then": {
        "properties": {
          "counts": {
            "properties": {
              "evaluatedCandidates": { "minimum": 1 },
              "filterIndeterminate": { "minimum": 1 }
            }
          },
          "booleanSelectivity": { "type": "number" },
          "indeterminateRatio": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "ratioOrNull": {
      "oneOf": [{ "$ref": "#/$defs/ratio" }, { "type": "null" }]
    },
    "counts": {
      "type": "object",
      "required": [
        "generatedBeforeCanonicalization",
        "canonicalCandidates",
        "evaluatedCandidates",
        "predicateRejected",
        "filterIndeterminate",
        "eligibleCandidates"
      ],
      "properties": {
        "generatedBeforeCanonicalization": { "$ref": "#/$defs/count" },
        "canonicalCandidates": { "$ref": "#/$defs/count" },
        "evaluatedCandidates": { "$ref": "#/$defs/count" },
        "predicateRejected": { "$ref": "#/$defs/count" },
        "filterIndeterminate": { "$ref": "#/$defs/count" },
        "eligibleCandidates": { "$ref": "#/$defs/count" }
      },
      "additionalProperties": false
    },
    "interpretation": {
      "type": "object",
      "required": ["status", "reasons"],
      "properties": {
        "status": { "enum": ["valid", "empty", "indeterminate"] },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1,
          "items": {
            "enum": [
              "no-evaluated-candidates",
              "indeterminate-ratio-exceeds-threshold"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
