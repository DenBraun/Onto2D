{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/oracle-response.schema.json",
  "title": "Onto2D Scientific Oracle Response",
  "type": "object",
  "required": ["requestHash", "values", "convergence", "solver", "wallTimeMs"],
  "properties": {
    "requestHash": { "$ref": "#/$defs/contentHash" },
    "values": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "quantity.schema.json" }
    },
    "convergence": { "enum": ["converged", "partial", "failed"] },
    "residual": { "$ref": "quantity.schema.json" },
    "solver": {
      "type": "object",
      "required": ["id", "version", "method", "parameters"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/parameterValue" }
        }
      },
      "additionalProperties": false
    },
    "wallTimeMs": { "type": "number", "minimum": 0 }
  },
  "$defs": {
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "parameterValue": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/parameterValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/parameterValue" }
        }
      ]
    }
  },
  "additionalProperties": false
}
