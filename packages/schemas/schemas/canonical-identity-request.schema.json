{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/canonical-identity-request.schema.json",
  "title": "Onto2D Canonical Identity Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate"],
  "properties": {
    "candidate": { "$ref": "#/$defs/candidateInput" },
    "options": { "$ref": "#/$defs/options" }
  },
  "$defs": {
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "normalizedString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\S|\\S(?:.*\\S)?)$"
    },
    "canonicalForm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "bytesBase64", "hash"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/normalizedString" },
        "bytesBase64": { "type": "string", "contentEncoding": "base64" },
        "hash": { "$ref": "#/$defs/contentHash" }
      }
    },
    "attributeValue": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "$ref": "quantity.schema.json" }
      ]
    },
    "attributes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/normalizedString" },
      "additionalProperties": { "$ref": "#/$defs/attributeValue" }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/contentHash" },
        "attrs": { "$ref": "#/$defs/attributes" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "role"],
      "properties": {
        "from": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "to": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "role": { "$ref": "#/$defs/normalizedString" },
        "attrs": { "$ref": "#/$defs/attributes" }
      }
    },
    "candidateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "nodes", "edges"],
      "properties": {
        "id": { "$ref": "#/$defs/contentHash" },
        "domain": { "enum": ["profile-quotient", "element-exact", "single-candidate"] },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        },
        "skeleton": { "$ref": "#/$defs/contentHash" },
        "canonicalForm": { "$ref": "#/$defs/canonicalForm" }
      }
    },
    "partialPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connected": { "type": "boolean" },
        "allowParallelEdges": { "type": "boolean" },
        "allowSelfLoops": { "type": "boolean" },
        "connectivityProjection": { "enum": ["undirected", "directed-strong", "directed-weak"] },
        "structuralNodeAttributes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/normalizedString" }
        },
        "structuralEdgeAttributes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/normalizedString" }
        }
      }
    },
    "partialLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxNodes": { "type": "integer", "minimum": 1 },
        "maxEdges": { "type": "integer", "minimum": 0 },
        "maxSearchStates": { "type": "integer", "minimum": 1 }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": { "$ref": "#/$defs/partialPolicy" },
        "limits": { "$ref": "#/$defs/partialLimits" }
      }
    }
  }
}
