{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-node-frontier-decision.schema.json",
  "title": "Onto2D Package Node-Frontier Authorization Decision",
  "type": "object",
  "required": [
    "schemaVersion", "controller", "packageId", "rulesHash", "bindingHash",
    "runConfigHash", "canonicalAuditHash", "nodeFrontierAuditHash", "predicateId",
    "predicatePlanHash", "extensionModel", "frontier", "connectivityUniverseFixed",
    "diagnostic", "pruningAuthorized", "reason", "decisionHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "controller": { "const": "package-node-frontier-controller-v1" },
    "packageId": { "$ref": "#/$defs/hash" },
    "rulesHash": { "$ref": "#/$defs/hash" },
    "bindingHash": { "$ref": "#/$defs/hash" },
    "runConfigHash": { "$ref": "#/$defs/hash" },
    "canonicalAuditHash": { "$ref": "#/$defs/hash" },
    "nodeFrontierAuditHash": { "$ref": "#/$defs/hash" },
    "predicateId": { "$ref": "#/$defs/id" },
    "predicatePlanHash": { "$ref": "#/$defs/hash" },
    "extensionModel": { "const": "incomplete-node-prefix-complete-raw-extension-v1" },
    "frontier": { "$ref": "#/$defs/frontier" },
    "connectivityUniverseFixed": { "type": "boolean" },
    "diagnostic": { "$ref": "partial-predicate-graph-evaluation.schema.json" },
    "pruningAuthorized": { "type": "boolean" },
    "reason": {
      "enum": [
        "authorized-persistent-node-frontier-failure",
        "connectivity-universe-not-fixed", "node-frontier-audit-not-passed",
        "plan-not-authorized", "persistent-failure-not-detected"
      ]
    },
    "decisionHash": { "$ref": "#/$defs/hash" }
  },
  "oneOf": [
    {
      "properties": {
        "pruningAuthorized": { "const": true },
        "connectivityUniverseFixed": { "const": true },
        "reason": { "const": "authorized-persistent-node-frontier-failure" }
      }
    },
    {
      "properties": {
        "pruningAuthorized": { "const": false },
        "reason": {
          "enum": [
            "connectivity-universe-not-fixed", "node-frontier-audit-not-passed",
            "plan-not-authorized", "persistent-failure-not-detected"
          ]
        }
      }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "id": {
      "type": "string", "minLength": 1, "maxLength": 1024,
      "pattern": "^(?:\\S|\\S(?:.*\\S)?)$"
    },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positiveCount": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "frontier": {
      "type": "object",
      "required": [
        "skeletonId", "assignedNodes", "totalNodes", "remainingNodeAssignments",
        "edgeRawCandidatesPerAssignment", "remainingRawCandidates"
      ],
      "properties": {
        "skeletonId": { "$ref": "#/$defs/hash" },
        "assignedNodes": { "$ref": "#/$defs/positiveCount" },
        "totalNodes": { "type": "integer", "minimum": 2, "maximum": 9007199254740991 },
        "remainingNodeAssignments": { "$ref": "#/$defs/positiveCount" },
        "edgeRawCandidatesPerAssignment": { "$ref": "#/$defs/positiveCount" },
        "remainingRawCandidates": { "$ref": "#/$defs/positiveCount" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
