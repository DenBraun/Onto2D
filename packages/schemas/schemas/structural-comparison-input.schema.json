                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "induced"
                },
                "nodeIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "maxItems": 6,
                  "uniqueItems": true
                }
              },
              "required": [
                "kind",
                "nodeIds"
              ]
            }
