{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/model-pack-registry.schema.json",
  "title": "Onto2D Model Pack registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "entries"],
  "properties": {
    "format": { "const": "onto2d-model-pack-registry" },
    "formatVersion": { "const": "1" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": { "enum": ["__proto__", "constructor", "prototype"] }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelId", "version", "rootHash", "manifestHash", "packPath"],
      "properties": {
        "modelId": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/identifier" },
        "rootHash": { "$ref": "#/$defs/contentHash" },
        "manifestHash": { "$ref": "#/$defs/contentHash" },
        "packPath": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2048,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._~-]*/)+$"
        }
      }
    }
  }
}
