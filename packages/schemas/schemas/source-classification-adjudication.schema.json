{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/source-classification-adjudication.schema.json",
  "title": "Onto2D Frozen Source Classification Adjudication",
  "type": "object",
  "required": [
    "schemaVersion",
    "freezer",
    "policyHash",
    "annotationHash",
    "frozenAt",
    "unblindedAt",
    "adjudicator",
    "decisions",
    "statistics",
    "fittingRisk",
    "fittingRiskReasons",
    "adjudicationHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "freezer": { "const": "source-classification-adjudication-v1" },
    "policyHash": { "$ref": "#/$defs/hash" },
    "annotationHash": { "$ref": "#/$defs/hash" },
    "frozenAt": { "$ref": "#/$defs/timestamp" },
    "unblindedAt": { "$ref": "#/$defs/timestamp" },
    "adjudicator": {
      "$ref": "source-classification-annotations.schema.json#/$defs/classifier"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["relationId", "kind", "rationale", "status", "rawKinds"],
        "properties": {
          "relationId": { "$ref": "#/$defs/identifier" },
          "kind": { "$ref": "#/$defs/relationKind" },
          "rationale": { "$ref": "#/$defs/text" },
          "status": { "enum": ["agreement", "adjudicated"] },
          "rawKinds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/relationKind" }
          }
        },
        "additionalProperties": false
      }
    },
    "statistics": {
      "type": "object",
      "required": [
        "relationCount",
        "disagreementCount",
        "disagreementRatio",
        "maximumClassificationDisagreementRatio",
        "thresholdExceeded"
      ],
      "properties": {
        "relationCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "disagreementCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "disagreementRatio": { "$ref": "#/$defs/ratio" },
        "maximumClassificationDisagreementRatio": { "$ref": "#/$defs/ratio" },
        "thresholdExceeded": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "fittingRisk": { "enum": ["not-flagged", "elevated"] },
    "fittingRiskReasons": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "historically-exposed",
          "classification-disagreement-threshold-exceeded"
        ]
      }
    },
    "adjudicationHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "relationKind": {
      "enum": [
        "generative",
        "constitutive",
        "intra-closure-support",
        "evidential",
        "descriptive",
        "regulatory-feedback"
      ]
    }
  },
  "additionalProperties": false
}
