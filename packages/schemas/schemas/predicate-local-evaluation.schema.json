{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/predicate-local-evaluation.schema.json",
  "title": "Onto2D Local Predicate Evaluation",
  "type": "object",
  "required": [
    "schemaVersion",
    "evaluator",
    "predicatePlanHash",
    "numericBindingHash",
    "candidateId",
    "graphPolicy",
    "outcome",
    "witnesses",
    "evaluationHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "evaluator": { "const": "local-predicate-evaluator-v1" },
    "predicatePlanHash": { "$ref": "#/$defs/hash" },
    "numericBindingHash": { "$ref": "#/$defs/hash" },
    "candidateId": { "$ref": "#/$defs/hash" },
    "graphPolicy": { "$ref": "graph-policy.schema.json" },
    "outcome": { "$ref": "#/$defs/outcome" },
    "witnesses": {
      "type": "array",
      "maxItems": 60000,
      "items": {
        "oneOf": [
          { "$ref": "predicate-graph-evaluation.schema.json#/$defs/witness" },
          { "$ref": "#/$defs/compareWitness" }
        ]
      }
    },
    "evaluationHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "outcome": { "enum": ["pass", "fail", "indeterminate"] },
    "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "indexList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/index" }
    },
    "normalizedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:\\S|\\S(?:.*\\S)?)$"
    },
    "valuePath": {
      "type": "string",
      "pattern": "^\\$(?:\\.(?:arg|args\\[[0-9]+\\]|left|right|terms\\[[0-9]+\\]|factors\\[[0-9]+\\]))*$"
    },
    "selection": {
      "type": "object",
      "required": ["expressionPath", "setKind", "count"],
      "properties": {
        "expressionPath": { "$ref": "#/$defs/valuePath" },
        "setKind": { "enum": ["nodes", "edges"] },
        "count": { "$ref": "#/$defs/index" },
        "nodeIndexes": { "$ref": "#/$defs/indexList" },
        "edgeIndexes": { "$ref": "#/$defs/indexList" },
        "roles": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/normalizedString" }
        }
      },
      "oneOf": [
        {
          "properties": { "setKind": { "const": "nodes" } },
          "required": ["nodeIndexes"],
          "not": { "anyOf": [{ "required": ["edgeIndexes"] }, { "required": ["roles"] }] }
        },
        {
          "properties": { "setKind": { "const": "edges" } },
          "required": ["edgeIndexes"],
          "not": { "required": ["nodeIndexes"] }
        }
      ],
      "additionalProperties": false
    },
    "evaluatedValue": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "exact", "rounded"],
          "properties": {
            "kind": { "const": "number" },
            "exact": { "$ref": "decimal-value.schema.json" },
            "rounded": { "$ref": "decimal-value.schema.json" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "exact", "rounded", "quantity"],
          "properties": {
            "kind": { "const": "quantity" },
            "exact": { "$ref": "decimal-value.schema.json" },
            "rounded": { "$ref": "decimal-value.schema.json" },
            "quantity": { "$ref": "quantity.schema.json" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "string" },
            "value": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "boolean" },
            "value": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "null" },
            "value": { "type": "null" }
          },
          "additionalProperties": false
        }
      ]
    },
    "comparison": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "relation"],
          "properties": {
            "kind": { "const": "number" },
            "relation": { "enum": [-1, 0, 1] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "comparator",
            "pass",
            "equivalent",
            "relation",
            "unit",
            "leftValue",
            "rightValue",
            "difference",
            "effectiveTolerance",
            "semanticPolicy"
          ],
          "properties": {
            "kind": { "const": "quantity" },
            "comparator": { "enum": ["eq", "ne", "lt", "lte", "gt", "gte"] },
            "pass": { "type": "boolean" },
            "equivalent": { "type": "boolean" },
            "relation": { "enum": [-1, 0, 1] },
            "unit": { "$ref": "#/$defs/normalizedString" },
            "leftValue": { "type": "number" },
            "rightValue": { "type": "number" },
            "difference": { "type": "number" },
            "effectiveTolerance": { "type": "number", "minimum": 0 },
            "semanticPolicy": { "enum": ["require-equal", "ignore"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "equal"],
          "properties": {
            "kind": { "const": "scalar" },
            "equal": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    },
    "compareWitness": {
      "type": "object",
      "required": [
        "expressionPath",
        "operator",
        "outcome",
        "comparator",
        "left",
        "right",
        "comparison",
        "selections"
      ],
      "properties": {
        "expressionPath": {
          "type": "string",
          "pattern": "^\\$(?:\\.(?:arg|args\\[[0-9]+\\]))*$"
        },
        "operator": { "const": "compare" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "comparator": { "enum": ["eq", "ne", "lt", "lte", "gt", "gte"] },
        "left": { "$ref": "#/$defs/evaluatedValue" },
        "right": { "$ref": "#/$defs/evaluatedValue" },
        "comparison": { "$ref": "#/$defs/comparison" },
        "selections": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/selection" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
