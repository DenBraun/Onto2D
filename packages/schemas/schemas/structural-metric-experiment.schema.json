                  "maxLength": 64
                },
                "upperTicks": {
                  "type": "string",
                  "pattern": "^(0|-?[1-9][0-9]*)$",
                  "maxLength": 64
                }
              },
              "required": [
                "lowerTicks",
                "upperTicks"
              ]
            }
          ]
        },
        "mean": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lowerNumeratorTicks": {
                  "type": "string",
                  "pattern": "^(0|-?[1-9][0-9]*)$",
                  "maxLength": 64
                },
                "upperNumeratorTicks": {
                  "type": "string",
                  "pattern": "^(0|-?[1-9][0-9]*)$",
                  "maxLength": 64
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16384
                }
              },
              "required": [
                "lowerNumeratorTicks",
                "upperNumeratorTicks",
                "denominator"
              ]
            }
          ]
        },
        "signs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "negative": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16384
            },
            "zero": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16384
            },
            "positive": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16384
            },
            "unresolved": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16384
            }
          },
          "required": [
            "negative",
            "zero",
