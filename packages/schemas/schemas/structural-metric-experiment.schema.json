      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "maxLength": 1024
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 1024
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "interval": {
