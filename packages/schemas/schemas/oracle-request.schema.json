{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/oracle-request.schema.json",
  "title": "Onto2D Scientific Oracle Request",
  "type": "object",
  "required": ["candidate", "quantities", "parameters", "toleranceTarget", "solver"],
  "properties": {
    "candidate": { "$ref": "#/$defs/canonicalForm" },
    "quantities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/quantitySpec" }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/parameterValue" }
    },
    "toleranceTarget": { "$ref": "#/$defs/tolerance" },
    "solver": { "$ref": "#/$defs/solverIdentity" }
  },
  "$defs": {
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "canonicalForm": {
      "type": "object",
      "required": ["schemaVersion", "bytesBase64", "hash"],
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1 },
        "bytesBase64": { "type": "string", "contentEncoding": "base64" },
        "hash": { "$ref": "#/$defs/contentHash" }
      },
      "additionalProperties": false
    },
    "tolerance": {
      "type": "object",
      "properties": {
        "absolute": { "type": "number", "minimum": 0 },
        "relative": { "type": "number", "minimum": 0 }
      },
      "anyOf": [
        { "required": ["absolute"] },
        { "required": ["relative"] }
      ],
      "additionalProperties": false
    },
    "quantitySpec": {
      "type": "object",
      "required": ["id", "unit", "semantic", "toleranceTarget"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "semantic": { "type": "string", "minLength": 1 },
        "toleranceTarget": { "$ref": "#/$defs/tolerance" }
      },
      "additionalProperties": false
    },
    "solverIdentity": {
      "type": "object",
      "required": ["id", "version", "method"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "parameterValue": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/parameterValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/parameterValue" }
        }
      ]
    }
  },
  "additionalProperties": false
}
