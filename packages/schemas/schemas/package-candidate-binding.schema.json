{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-candidate-binding.schema.json",
  "title": "Onto2D Package Candidate Enumeration Binding",
  "type": "object",
  "required": [
    "schemaVersion",
    "binder",
    "packageId",
    "depthBasis",
    "runConfigHash",
    "runConfig",
    "sourcePopulation",
    "enumerationInput",
    "enumerationOptions",
    "bindingHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "binder": { "const": "package-candidate-binding-v2" },
    "packageId": { "$ref": "#/$defs/contentHash" },
    "depthBasis": { "$ref": "#/$defs/contentHash" },
    "runConfigHash": { "$ref": "#/$defs/contentHash" },
    "runConfig": { "$ref": "run-config.schema.json" },
    "sourcePopulation": { "$ref": "#/$defs/sourcePopulation" },
    "enumerationInput": { "$ref": "candidate-enumeration-input.schema.json" },
    "enumerationOptions": { "$ref": "#/$defs/enumerationOptions" },
    "bindingHash": { "$ref": "#/$defs/contentHash" }
  },
  "$defs": {
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sourcePopulation": {
      "type": "object",
      "required": [
        "kind",
        "population",
        "selection",
        "elementIds",
        "profileRepresentativePolicy",
        "profileClasses"
      ],
      "properties": {
        "kind": { "const": "primitive-depth-population-selection-v1" },
        "population": { "$ref": "primitive-depth-population.schema.json" },
        "selection": {
          "type": "object",
          "required": ["sourceDepths", "targetDepth", "availableDepths", "selectedDepths"],
          "properties": {
            "sourceDepths": { "enum": ["all-below", "previous-only"] },
            "targetDepth": { "const": 1 },
            "availableDepths": {
              "type": "array",
              "prefixItems": [{ "const": 0 }],
              "minItems": 1,
              "maxItems": 1
            },
            "selectedDepths": {
              "type": "array",
              "prefixItems": [{ "const": 0 }],
              "minItems": 1,
              "maxItems": 1
            }
          },
          "additionalProperties": false
        },
        "elementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contentHash" }
        },
        "profileRepresentativePolicy": {
          "const": "lexicographically-smallest-element-id-v1"
        },
        "profileClasses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/profileClass" }
        }
      },
      "additionalProperties": false
    },
    "profileClass": {
      "type": "object",
      "required": ["profileHash", "members", "representativeElementId"],
      "properties": {
        "profileHash": { "$ref": "#/$defs/contentHash" },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contentHash" }
        },
        "representativeElementId": { "$ref": "#/$defs/contentHash" }
      },
      "additionalProperties": false
    },
    "enumerationOptions": {
      "type": "object",
      "required": [
        "maxEdges",
        "maxRawCandidates",
        "maxCandidates",
        "maxDecorationStates",
        "canonicalizationLimits"
      ],
      "properties": {
        "maxEdges": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "const": "n+2" }
          ]
        },
        "maxRawCandidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxCandidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxDecorationStates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "canonicalizationLimits": {
          "type": "object",
          "required": ["maxNodes", "maxEdges", "maxSearchStates"],
          "properties": {
            "maxNodes": { "type": "integer", "minimum": 1, "maximum": 6 },
            "maxEdges": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maxSearchStates": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
