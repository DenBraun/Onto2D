{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/kernel-package.schema.json",
  "title": "Onto2D Rule Package",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "primitives"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "sourceArtifacts": { "type": "array", "items": { "$ref": "artifact-ref.schema.json" } },
    "sourceMigration": { "type": "object" },
    "evidence": { "type": "array", "items": { "$ref": "evidence.schema.json" } },
    "claims": { "type": "array", "items": { "$ref": "claim.schema.json" } },
    "primitives": { "type": "array", "minItems": 1, "items": { "$ref": "primitive.schema.json" } },
    "predicates": { "type": "array", "items": { "$ref": "predicate.schema.json" } },
    "functionals": { "type": "array", "items": { "$ref": "functional.schema.json" } },
    "cohortRules": { "type": "array", "items": { "$ref": "cohort-rule.schema.json" } },
    "selectors": { "type": "array", "items": { "$ref": "selector.schema.json" } },
    "partialOraclePolicy": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode"],
          "properties": { "mode": { "const": "indeterminate" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "toleranceMultiplier"],
          "properties": {
            "mode": { "const": "accept-expanded-tolerance" },
            "toleranceMultiplier": { "type": "number", "minimum": 1 },
            "maximumResidual": { "$ref": "quantity.schema.json" }
          },
          "additionalProperties": false
        }
      ]
    },
    "ontologyAxes": { "$ref": "ontology-axis.schema.json" },
    "perturbations": { "type": "array", "items": {} },
    "profileDefinition": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "const": "explicit-only" } },
      "additionalProperties": false
    },
    "identityPolicy": { "$ref": "identity-policy.schema.json" }
  },
  "additionalProperties": false
}
