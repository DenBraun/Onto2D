{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/kernel-package.schema.json",
  "title": "Onto2D Rule Package",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "primitives"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "sourceArtifacts": { "type": "array", "items": { "$ref": "artifact-ref.schema.json" } },
    "sourceMigration": { "$ref": "source-migration-binding.schema.json" },
    "evidence": { "type": "array", "items": { "$ref": "evidence.schema.json" } },
    "claims": { "type": "array", "items": { "$ref": "claim.schema.json" } },
    "primitives": { "type": "array", "minItems": 1, "items": { "$ref": "primitive.schema.json" } },
    "predicates": { "type": "array", "items": { "$ref": "predicate.schema.json" } },
    "functionals": { "type": "array", "items": { "$ref": "functional.schema.json" } },
    "cohortRules": { "type": "array", "items": { "$ref": "cohort-rule.schema.json" } },
    "selectors": { "type": "array", "items": { "$ref": "selector.schema.json" } },
    "partialOraclePolicy": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode"],
          "properties": { "mode": { "const": "indeterminate" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "toleranceMultiplier"],
          "properties": {
            "mode": { "const": "accept-expanded-tolerance" },
            "toleranceMultiplier": { "type": "number", "minimum": 1 },
            "maximumResidual": { "$ref": "quantity.schema.json" }
          },
          "additionalProperties": false
        }
      ]
    },
    "ontologyAxes": { "$ref": "ontology-axis.schema.json" },
    "perturbations": {
      "type": "array",
      "items": { "$ref": "perturbation-definition.schema.json" }
    },
    "candidateAttributes": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "candidate-attribute-definition.schema.json" }
    },
    "profileDefinition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "explicit-only" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "baseProfile",
            "derivedTypeTags",
            "claimRefs"
          ],
          "properties": {
            "kind": { "const": "residual-slots-v1" },
            "baseProfile": { "$ref": "profile.schema.json" },
            "derivedTypeTags": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "quantity.schema.json#/$defs/normalizedString"
              }
            },
            "claimRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "quantity.schema.json#/$defs/normalizedString"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "baseProfile",
            "derivedTypeTags",
            "claimRefs",
            "derivedInvariants"
          ],
          "properties": {
            "kind": { "const": "residual-slots-v2" },
            "baseProfile": { "$ref": "profile.schema.json" },
            "derivedTypeTags": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "quantity.schema.json#/$defs/normalizedString"
              }
            },
            "claimRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "quantity.schema.json#/$defs/normalizedString"
              }
            },
            "derivedInvariants": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": ["semantic", "functional", "quantization"],
                "properties": {
                  "semantic": {
                    "$ref": "quantity.schema.json#/$defs/normalizedString"
                  },
                  "functional": {
                    "$ref": "quantity.schema.json#/$defs/normalizedString"
                  },
                  "quantization": { "$ref": "quantity.schema.json" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "baseProfile",
            "derivedTypeTags",
            "claimRefs",
            "derivedInvariants",
            "derivedTypeRules"
          ],
          "properties": {
            "kind": { "const": "residual-slots-v3" },
            "baseProfile": { "$ref": "profile.schema.json" },
            "derivedTypeTags": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "quantity.schema.json#/$defs/normalizedString"
              }
            },
            "claimRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "quantity.schema.json#/$defs/normalizedString"
              }
            },
            "derivedInvariants": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": ["semantic", "functional", "quantization"],
                "properties": {
                  "semantic": {
                    "$ref": "quantity.schema.json#/$defs/normalizedString"
                  },
                  "functional": {
                    "$ref": "quantity.schema.json#/$defs/normalizedString"
                  },
                  "quantization": { "$ref": "quantity.schema.json" }
                },
                "additionalProperties": false
              }
            },
            "derivedTypeRules": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": ["typeTag", "invariant", "comparator", "threshold"],
                "properties": {
                  "typeTag": {
                    "$ref": "quantity.schema.json#/$defs/normalizedString"
                  },
                  "invariant": {
                    "$ref": "quantity.schema.json#/$defs/normalizedString"
                  },
                  "comparator": {
                    "enum": ["eq", "ne", "lt", "lte", "gt", "gte"]
                  },
                  "threshold": { "$ref": "quantity.schema.json" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "identityPolicy": { "$ref": "identity-policy.schema.json" }
  },
  "additionalProperties": false
}
