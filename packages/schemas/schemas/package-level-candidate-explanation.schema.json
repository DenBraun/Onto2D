{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-level-candidate-explanation.schema.json",
  "title": "Onto2D Package Level Candidate Explanation",
  "type": "object",
  "required": [
    "schemaVersion",
    "explainer",
    "indexHash",
    "packageId",
    "rulesHash",
    "runHash",
    "levelHash",
    "targetDepth",
    "candidateId",
    "entry",
    "explanationHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "explainer": { "const": "package-level-candidate-explainer-v1" },
    "indexHash": { "$ref": "#/$defs/hash" },
    "packageId": { "$ref": "#/$defs/hash" },
    "rulesHash": { "$ref": "#/$defs/hash" },
    "runHash": { "$ref": "#/$defs/hash" },
    "levelHash": { "$ref": "#/$defs/hash" },
    "targetDepth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "candidateId": { "$ref": "#/$defs/hash" },
    "entry": {
      "$ref": "package-level-explanation-index.schema.json#/$defs/entry"
    },
    "explanationHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
