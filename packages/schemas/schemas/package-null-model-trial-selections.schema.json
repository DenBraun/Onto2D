{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-null-model-trial-selections.schema.json",
  "title": "Onto2D Null-Model Occurrence Selector Replays",
  "type": "object",
  "required": [
    "schemaVersion",
    "evaluator",
    "scope",
    "trialCensusesHash",
    "packageId",
    "rulesHash",
    "runConfigHash",
    "bindingHash",
    "censusHash",
    "carrierHash",
    "countingDomain",
    "selectionPolicy",
    "selectorOrder",
    "trials",
    "counts",
    "execution",
    "status",
    "interpretation",
    "trialSelectionsHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "evaluator": { "const": "package-null-model-trial-selections-v1" },
    "scope": {
      "const": "complete-occurrence-cohort-functional-selector-replay-v1"
    },
    "trialCensusesHash": { "$ref": "#/$defs/hash" },
    "packageId": { "$ref": "#/$defs/hash" },
    "rulesHash": { "$ref": "#/$defs/hash" },
    "runConfigHash": { "$ref": "#/$defs/hash" },
    "bindingHash": { "$ref": "#/$defs/hash" },
    "censusHash": { "$ref": "#/$defs/hash" },
    "carrierHash": { "$ref": "#/$defs/hash" },
    "countingDomain": { "enum": ["profile-quotient", "element-exact"] },
    "selectionPolicy": { "$ref": "#/$defs/selectionPolicy" },
    "selectorOrder": { "$ref": "#/$defs/idSet" },
    "trials": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/trial" }
    },
    "counts": { "$ref": "#/$defs/aggregateCounts" },
    "execution": { "$ref": "#/$defs/execution" },
    "status": { "enum": ["complete", "not-run"] },
    "interpretation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "reasons"],
          "properties": {
            "status": { "const": "trial-selection-complete" },
            "reasons": {
              "const": ["metric-distributions-and-baseline-interpretation-pending"]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "reasons"],
          "properties": {
            "status": { "const": "not-run" },
            "reasons": { "const": ["null-models-disabled"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "trialSelectionsHash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "complete" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "trials": { "minItems": 1 },
          "counts": { "properties": { "trials": { "minimum": 1 } } },
          "interpretation": {
            "properties": { "status": { "const": "trial-selection-complete" } },
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "not-run" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "trials": { "maxItems": 0 },
          "counts": { "$ref": "#/$defs/zeroAggregateCounts" },
          "interpretation": {
            "properties": { "status": { "const": "not-run" } },
            "required": ["status"]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "normalizedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:\\S|\\S(?:.*\\S)?)$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bigCount": {
      "oneOf": [
        { "$ref": "#/$defs/count" },
        { "type": "string", "pattern": "^[1-9][0-9]*$" }
      ]
    },
    "ratioOrNull": {
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "null" }
      ]
    },
    "hashSet": {
      "type": "array",
      "maxItems": 1000000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hash" }
    },
    "idSet": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/normalizedString" }
    },
    "selectionPolicy": {
      "type": "object",
      "required": [
        "memberIdentity",
        "duplicateCandidates",
        "cohortKeys",
        "functionalValues",
        "selectorAdmission",
        "sensitivity",
        "nodeInternalQuantities",
        "derivedEvidence"
      ],
      "properties": {
        "memberIdentity": { "const": "trial-occurrence-id-v1" },
        "duplicateCandidates": {
          "const": "retain-as-distinct-occurrences-v1"
        },
        "cohortKeys": {
          "const": "recompute-on-proposed-candidate-per-trial-v1"
        },
        "functionalValues": {
          "const": "recompute-every-occurrence-per-selector-v1"
        },
        "selectorAdmission": {
          "const": "rerank-and-readmit-per-trial-v1"
        },
        "sensitivity": {
          "const": "repeat-declared-complete-sweep-per-trial-v1"
        },
        "nodeInternalQuantities": {
          "const": "fixed-unless-randomized-by-model-v1"
        },
        "derivedEvidence": {
          "const": "recompute-with-functional-or-mark-indeterminate-v1"
        }
      },
      "additionalProperties": false
    },
    "metricState": {
      "type": "object",
      "required": ["status", "reasons"],
      "properties": {
        "status": { "enum": ["valid", "empty", "indeterminate"] },
        "reasons": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/normalizedString" }
        }
      },
      "additionalProperties": false
    },
    "variationalMetricState": {
      "type": "object",
      "required": ["status", "reasons"],
      "properties": {
        "status": {
          "enum": ["valid", "fragile", "not-applicable", "indeterminate"]
        },
        "reasons": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/normalizedString" }
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "booleanSelectivity",
        "variationalSelectivity",
        "selectionRetention",
        "overallRetention",
        "indeterminateRatio"
      ],
      "properties": {
        "booleanSelectivity": { "$ref": "#/$defs/ratioOrNull" },
        "variationalSelectivity": {
          "type": "object",
          "maxProperties": 10000,
          "additionalProperties": { "$ref": "#/$defs/ratioOrNull" }
        },
        "selectionRetention": { "$ref": "#/$defs/ratioOrNull" },
        "overallRetention": { "$ref": "#/$defs/ratioOrNull" },
        "indeterminateRatio": { "$ref": "#/$defs/ratioOrNull" }
      },
      "additionalProperties": false
    },
    "metricInterpretation": {
      "type": "object",
      "required": [
        "booleanSelectivity",
        "variationalSelectivity",
        "selectionRetention",
        "overallRetention",
        "indeterminateRatio"
      ],
      "properties": {
        "booleanSelectivity": { "$ref": "#/$defs/metricState" },
        "variationalSelectivity": {
          "type": "object",
          "maxProperties": 10000,
          "additionalProperties": { "$ref": "#/$defs/variationalMetricState" }
        },
        "selectionRetention": { "$ref": "#/$defs/metricState" },
        "overallRetention": { "$ref": "#/$defs/metricState" },
        "indeterminateRatio": { "$ref": "#/$defs/metricState" }
      },
      "additionalProperties": false
    },
    "trialCounts": {
      "type": "object",
      "required": [
        "evaluatedOccurrences",
        "predicateRejected",
        "filterIndeterminate",
        "eligible",
        "selectorExcluded",
        "selectionIndeterminate",
        "selected",
        "finalIndeterminate",
        "baseFunctionalEvaluations",
        "sensitivityFunctionalEvaluations"
      ],
      "properties": {
        "evaluatedOccurrences": { "$ref": "#/$defs/count" },
        "predicateRejected": { "$ref": "#/$defs/count" },
        "filterIndeterminate": { "$ref": "#/$defs/count" },
        "eligible": { "$ref": "#/$defs/count" },
        "selectorExcluded": { "$ref": "#/$defs/count" },
        "selectionIndeterminate": { "$ref": "#/$defs/count" },
        "selected": { "$ref": "#/$defs/count" },
        "finalIndeterminate": { "$ref": "#/$defs/count" },
        "baseFunctionalEvaluations": { "$ref": "#/$defs/count" },
        "sensitivityFunctionalEvaluations": { "$ref": "#/$defs/count" }
      },
      "additionalProperties": false
    },
    "trial": {
      "type": "object",
      "required": [
        "trialId",
        "model",
        "trialCensusHash",
        "memberIdentity",
        "selectorExecutions",
        "admission",
        "selectedOccurrenceIds",
        "metrics",
        "metricInterpretation",
        "counts",
        "status",
        "interpretation",
        "trialSelectionHash"
      ],
      "properties": {
        "trialId": { "$ref": "#/$defs/hash" },
        "model": { "enum": ["role-shuffle", "degree-rewire", "uniform"] },
        "trialCensusHash": { "$ref": "#/$defs/hash" },
        "memberIdentity": { "const": "trial-occurrence-id-v1" },
        "selectorExecutions": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "package-selector-admission.schema.json#/$defs/selectorExecution"
          }
        },
        "admission": { "$ref": "package-selector-admission.schema.json" },
        "selectedOccurrenceIds": { "$ref": "#/$defs/hashSet" },
        "metrics": { "$ref": "#/$defs/metrics" },
        "metricInterpretation": { "$ref": "#/$defs/metricInterpretation" },
        "counts": { "$ref": "#/$defs/trialCounts" },
        "status": { "enum": ["complete", "empty", "indeterminate"] },
        "interpretation": {
          "$ref": "package-selector-admission.schema.json#/properties/interpretation"
        },
        "trialSelectionHash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "aggregateCounts": {
      "type": "object",
      "required": [
        "trials",
        "completeTrials",
        "emptyTrials",
        "indeterminateTrials",
        "evaluatedOccurrences",
        "selectedOccurrences",
        "baseFunctionalEvaluations",
        "sensitivityFunctionalEvaluations"
      ],
      "properties": {
        "trials": { "$ref": "#/$defs/count" },
        "completeTrials": { "$ref": "#/$defs/count" },
        "emptyTrials": { "$ref": "#/$defs/count" },
        "indeterminateTrials": { "$ref": "#/$defs/count" },
        "evaluatedOccurrences": { "$ref": "#/$defs/count" },
        "selectedOccurrences": { "$ref": "#/$defs/count" },
        "baseFunctionalEvaluations": { "$ref": "#/$defs/count" },
        "sensitivityFunctionalEvaluations": { "$ref": "#/$defs/count" }
      },
      "additionalProperties": false
    },
    "zeroAggregateCounts": {
      "allOf": [
        { "$ref": "#/$defs/aggregateCounts" },
        {
          "properties": {
            "trials": { "const": 0 },
            "completeTrials": { "const": 0 },
            "emptyTrials": { "const": 0 },
            "indeterminateTrials": { "const": 0 },
            "evaluatedOccurrences": { "const": 0 },
            "selectedOccurrences": { "const": 0 },
            "baseFunctionalEvaluations": { "const": 0 },
            "sensitivityFunctionalEvaluations": { "const": 0 }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "required": [
        "maxFunctionalEvaluations",
        "maxSensitivityFunctionalEvaluations",
        "preflight"
      ],
      "properties": {
        "maxFunctionalEvaluations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maxSensitivityFunctionalEvaluations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "preflight": {
          "type": "object",
          "required": [
            "eligibleOccurrences",
            "requiredBaseFunctionalEvaluations",
            "requiredSensitivityVariantsPerTrial",
            "sensitivityEvaluationUpperBound"
          ],
          "properties": {
            "eligibleOccurrences": { "$ref": "#/$defs/count" },
            "requiredBaseFunctionalEvaluations": { "$ref": "#/$defs/count" },
            "requiredSensitivityVariantsPerTrial": { "$ref": "#/$defs/bigCount" },
            "sensitivityEvaluationUpperBound": { "$ref": "#/$defs/bigCount" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
