{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/rdf-import-artifact.schema.json",
  "title": "Onto2D RDF Import Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "format",
    "formatVersion",
    "profile",
    "source",
    "statements",
    "statistics",
    "graphHash",
    "importHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "format": { "const": "onto2d-rdf-import" },
    "formatVersion": { "const": "1" },
    "profile": { "const": "rdf11-n-triples-safe-v1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mediaType", "encoding", "bytes", "hash"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "mediaType": { "const": "application/n-triples" },
        "encoding": { "const": "utf-8" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 8388608 },
        "hash": { "$ref": "#/$defs/contentHash" }
      }
    },
    "statements": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/statement" }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceStatementCount",
        "statementCount",
        "duplicateStatementCount",
        "termCount",
        "iriTermCount",
        "blankNodeCount",
        "literalCount"
      ],
      "properties": {
        "sourceStatementCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "statementCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "duplicateStatementCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "termCount": { "type": "integer", "minimum": 0, "maximum": 300000 },
        "iriTermCount": { "type": "integer", "minimum": 0, "maximum": 300000 },
        "blankNodeCount": { "type": "integer", "minimum": 0, "maximum": 200000 },
        "literalCount": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "graphHash": { "$ref": "#/$defs/contentHash" },
    "importHash": { "$ref": "#/$defs/contentHash" }
  },
  "$defs": {
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "absoluteIri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
    },
    "iriTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "termType", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/contentHash" },
        "termType": { "const": "iri" },
        "value": { "$ref": "#/$defs/absoluteIri" }
      }
    },
    "blankNodeTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "termType", "value", "scope"],
      "properties": {
        "id": { "$ref": "#/$defs/contentHash" },
        "termType": { "const": "blank-node" },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_-])?$"
        },
        "scope": { "$ref": "#/$defs/contentHash" }
      }
    },
    "literalTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "termType", "value", "datatype", "language"],
      "properties": {
        "id": { "$ref": "#/$defs/contentHash" },
        "termType": { "const": "literal" },
        "value": { "type": "string", "maxLength": 16384 },
        "datatype": { "$ref": "#/$defs/absoluteIri" },
        "language": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "pattern": "^[a-z]+(?:-[a-z0-9]+)*$",
              "maxLength": 16384
            }
          ]
        }
      },
      "if": { "properties": { "language": { "type": "string" } } },
      "then": {
        "properties": {
          "datatype": {
            "const": "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
          }
        }
      }
    },
    "subjectTerm": {
      "oneOf": [
        { "$ref": "#/$defs/iriTerm" },
        { "$ref": "#/$defs/blankNodeTerm" }
      ]
    },
    "objectTerm": {
      "oneOf": [
        { "$ref": "#/$defs/iriTerm" },
        { "$ref": "#/$defs/blankNodeTerm" },
        { "$ref": "#/$defs/literalTerm" }
      ]
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "predicate", "object", "occurrences"],
      "properties": {
        "id": { "$ref": "#/$defs/contentHash" },
        "subject": { "$ref": "#/$defs/subjectTerm" },
        "predicate": { "$ref": "#/$defs/iriTerm" },
        "object": { "$ref": "#/$defs/objectTerm" },
        "occurrences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200000,
          "items": { "type": "integer", "minimum": 1, "maximum": 200000 }
        }
      }
    }
  }
}
