{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-depth-node-growth-pruned-candidate-generation.schema.json",
  "title": "Onto2D Depth-Aware Node-Growth Pruned Candidate Generation",
  "type": "object",
  "required": [
    "schemaVersion", "generator", "packageId", "rulesHash", "bindingHash",
    "runConfigHash", "canonicalAuditHash", "nodeFrontierAuditHash",
    "targetDepth", "sourcePopulationHash", "binding", "enumeration",
    "profileComposition", "pruning", "conformance", "generationHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "generator": { "const": "package-depth-node-growth-pruned-candidate-generator-v1" },
    "packageId": { "$ref": "#/$defs/hash" },
    "rulesHash": { "$ref": "#/$defs/hash" },
    "bindingHash": { "$ref": "#/$defs/hash" },
    "runConfigHash": { "$ref": "#/$defs/hash" },
    "canonicalAuditHash": { "$ref": "#/$defs/hash" },
    "nodeFrontierAuditHash": { "$ref": "#/$defs/hash" },
    "targetDepth": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "sourcePopulationHash": { "$ref": "#/$defs/hash" },
    "binding": { "$ref": "package-depth-candidate-binding.schema.json" },
    "enumeration": {
      "allOf": [
        { "$ref": "candidate-enumeration-result.schema.json" },
        { "properties": { "status": { "const": "complete" }, "interpretable": { "const": true } } }
      ]
    },
    "profileComposition": { "$ref": "package-profile-composition.schema.json" },
    "pruning": { "$ref": "#/$defs/pruning" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "generationHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "id": {
      "type": "string", "minLength": 1, "maxLength": 1024,
      "pattern": "^(?:\\S|\\S(?:.*\\S)?)$"
    },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "pruning": {
      "type": "object",
      "required": [
        "strategy", "transcriptHash", "nodeFrontierAuthorizedPredicateIds",
        "preAdmissionAuthorizedPredicateIds", "prunedNodeFrontiers", "counts"
      ],
      "properties": {
        "strategy": { "const": "audited-node-assignment-subtree-pruning-v1" },
        "transcriptHash": { "$ref": "#/$defs/hash" },
        "nodeFrontierAuthorizedPredicateIds": {
          "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" }
        },
        "preAdmissionAuthorizedPredicateIds": {
          "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" }
        },
        "prunedNodeFrontiers": {
          "type": "array", "items": { "$ref": "#/$defs/prunedNodeFrontier" }
        },
        "counts": { "$ref": "package-node-growth-pruned-candidate-generation.schema.json#/$defs/pruningCounts" }
      },
      "additionalProperties": false
    },
    "prunedNodeFrontier": {
      "type": "object",
      "required": [
        "frontierOrdinal", "partialGraph", "decision", "profileExtension"
      ],
      "properties": {
        "frontierOrdinal": { "$ref": "#/$defs/count" },
        "partialGraph": {
          "allOf": [
            { "$ref": "partial-predicate-graph.schema.json" },
            { "properties": { "nodesComplete": { "const": false } } }
          ]
        },
        "decision": { "$ref": "package-depth-node-frontier-decision.schema.json" },
        "profileExtension": {
          "$ref": "package-generator-frontier-audit.schema.json#/$defs/profileExtensionFrontier"
        }
      },
      "additionalProperties": false
    },
    "conformance": {
      "type": "object",
      "required": [
        "status", "preAdmissionGenerationHash", "nodeGrowthRetainedStoreHash",
        "preAdmissionRetainedStoreHash", "pruningDisabledCanonicalCandidates",
        "preAdmissionCanonicalCandidates", "nodeGrowthCanonicalCandidates",
        "eligible", "indeterminate"
      ],
      "properties": {
        "status": { "const": "passed" },
        "preAdmissionGenerationHash": { "$ref": "#/$defs/hash" },
        "nodeGrowthRetainedStoreHash": { "$ref": "#/$defs/hash" },
        "preAdmissionRetainedStoreHash": { "$ref": "#/$defs/hash" },
        "pruningDisabledCanonicalCandidates": { "$ref": "#/$defs/count" },
        "preAdmissionCanonicalCandidates": { "$ref": "#/$defs/count" },
        "nodeGrowthCanonicalCandidates": { "$ref": "#/$defs/count" },
        "eligible": { "$ref": "package-node-growth-pruned-candidate-generation.schema.json#/$defs/resultSet" },
        "indeterminate": { "$ref": "package-node-growth-pruned-candidate-generation.schema.json#/$defs/resultSet" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
