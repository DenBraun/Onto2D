{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/source-migration-reconciliation.schema.json",
  "title": "Onto2D Source Migration Reconciliation Diagnostics",
  "type": "object",
  "required": [
    "schemaVersion",
    "reporter",
    "classificationPolicyHash",
    "annotationHash",
    "adjudicationHash",
    "amendmentsHash",
    "projectionHash",
    "resolutionHash",
    "condensationHash",
    "rawGraph",
    "classification",
    "resolution",
    "riskSignals",
    "reconciliation",
    "reportHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "reporter": { "const": "source-migration-reconciliation-v1" },
    "classificationPolicyHash": { "$ref": "#/$defs/hash" },
    "annotationHash": { "$ref": "#/$defs/hash" },
    "adjudicationHash": { "$ref": "#/$defs/hash" },
    "amendmentsHash": { "$ref": "#/$defs/hash" },
    "projectionHash": { "$ref": "#/$defs/hash" },
    "resolutionHash": { "$ref": "#/$defs/hash" },
    "condensationHash": { "$ref": "#/$defs/hash" },
    "rawGraph": {
      "type": "object",
      "required": [
        "nodes",
        "relations",
        "nontrivialSccs",
        "sizeHistogram",
        "largestScc",
        "twoNodeSccs",
        "components"
      ],
      "properties": {
        "nodes": { "$ref": "#/$defs/nodeCount" },
        "relations": { "$ref": "#/$defs/relationCount" },
        "nontrivialSccs": { "$ref": "#/$defs/nodeCount" },
        "sizeHistogram": { "$ref": "#/$defs/histogram" },
        "largestScc": { "$ref": "#/$defs/nodeCount" },
        "twoNodeSccs": { "$ref": "#/$defs/nodeCount" },
        "components": {
          "type": "array",
          "maxItems": 20000,
          "items": { "$ref": "#/$defs/rawComponent" }
        }
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "required": [
        "edgesByKind",
        "blindnessStatus",
        "disagreementCount",
        "disagreementRatio",
        "generativeCyclicComponents",
        "formationSupportCyclicComponents"
      ],
      "properties": {
        "edgesByKind": {
          "type": "object",
          "required": [
            "generative",
            "constitutive",
            "intra-closure-support",
            "evidential",
            "descriptive",
            "regulatory-feedback"
          ],
          "properties": {
            "generative": { "$ref": "#/$defs/relationCount" },
            "constitutive": { "$ref": "#/$defs/relationCount" },
            "intra-closure-support": { "$ref": "#/$defs/relationCount" },
            "evidential": { "$ref": "#/$defs/relationCount" },
            "descriptive": { "$ref": "#/$defs/relationCount" },
            "regulatory-feedback": { "$ref": "#/$defs/relationCount" }
          },
          "additionalProperties": false
        },
        "blindnessStatus": {
          "enum": [
            "prospective-blind",
            "deterministic-precommitted",
            "historically-exposed"
          ]
        },
        "disagreementCount": { "$ref": "#/$defs/relationCount" },
        "disagreementRatio": { "$ref": "#/$defs/ratio" },
        "generativeCyclicComponents": { "$ref": "#/$defs/nodeCount" },
        "formationSupportCyclicComponents": { "$ref": "#/$defs/nodeCount" }
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "required": [
        "vertices",
        "condensedClusters",
        "constitutiveClusters",
        "clusteredSourceRecords",
        "clusteredSourceRecordRatio",
        "constitutiveClusterSizeHistogram",
        "destinationCounts",
        "nonformationResolvedRawSccs",
        "nonformationLayerResolutionShare",
        "descriptiveResolvedRawSccs",
        "descriptiveResolutionShare"
      ],
      "properties": {
        "vertices": { "$ref": "#/$defs/nodeCount" },
        "condensedClusters": { "$ref": "#/$defs/nodeCount" },
        "constitutiveClusters": { "$ref": "#/$defs/nodeCount" },
        "clusteredSourceRecords": { "$ref": "#/$defs/nodeCount" },
        "clusteredSourceRecordRatio": { "$ref": "#/$defs/ratio" },
        "constitutiveClusterSizeHistogram": { "$ref": "#/$defs/histogram" },
        "destinationCounts": {
          "type": "object",
          "required": ["inter-cluster", "internal", "typed-explanation"],
          "properties": {
            "inter-cluster": { "$ref": "#/$defs/relationCount" },
            "internal": { "$ref": "#/$defs/relationCount" },
            "typed-explanation": { "$ref": "#/$defs/relationCount" }
          },
          "additionalProperties": false
        },
        "nonformationResolvedRawSccs": { "$ref": "#/$defs/nodeCount" },
        "nonformationLayerResolutionShare": { "$ref": "#/$defs/ratio" },
        "descriptiveResolvedRawSccs": { "$ref": "#/$defs/nodeCount" },
        "descriptiveResolutionShare": { "$ref": "#/$defs/ratio" }
      },
      "additionalProperties": false
    },
    "riskSignals": {
      "type": "object",
      "required": [
        "historicalExposure",
        "classificationDisagreement",
        "descriptiveResolution",
        "postUnblindingReclassification",
        "fittingRisk",
        "fittingRiskReasons",
        "effectiveClassification"
      ],
      "properties": {
        "historicalExposure": { "type": "boolean" },
        "classificationDisagreement": { "$ref": "#/$defs/thresholdSignal" },
        "descriptiveResolution": { "$ref": "#/$defs/thresholdSignal" },
        "postUnblindingReclassification": { "$ref": "#/$defs/thresholdSignal" },
        "fittingRisk": { "enum": ["not-flagged", "elevated"] },
        "fittingRiskReasons": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "historically-exposed",
              "classification-disagreement-threshold-exceeded",
              "descriptive-resolution-threshold-exceeded",
              "post-unblinding-reclassification-threshold-exceeded"
            ]
          }
        },
        "effectiveClassification": { "const": "current" }
      },
      "additionalProperties": false
    },
    "reconciliation": {
      "type": "object",
      "required": ["nodesExactlyOnce", "relationsExactlyOnce", "quotientIsDag"],
      "properties": {
        "nodesExactlyOnce": { "const": true },
        "relationsExactlyOnce": { "const": true },
        "quotientIsDag": { "const": true }
      },
      "additionalProperties": false
    },
    "reportHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "nodeCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20000
    },
    "relationCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "histogram": {
      "type": "object",
      "propertyNames": { "pattern": "^[1-9][0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/nodeCount" }
    },
    "rawComponent": {
      "type": "object",
      "required": ["componentId", "members", "internalRelationIds"],
      "properties": {
        "componentId": { "$ref": "#/$defs/hash" },
        "members": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "internalRelationIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      },
      "additionalProperties": false
    },
    "thresholdSignal": {
      "type": "object",
      "required": ["actual", "maximum", "exceeded"],
      "properties": {
        "actual": { "$ref": "#/$defs/ratio" },
        "maximum": { "$ref": "#/$defs/ratio" },
        "exceeded": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
