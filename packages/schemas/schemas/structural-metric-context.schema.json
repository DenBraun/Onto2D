{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/structural-metric-context.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "model": {
      "$ref": "structural-projection.schema.json#/$defs/modelBinding"
    },
    "sourceProjectionHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "projectionPolicyHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "normalizationContext": {
      "const": "full-source-projection"
    },
    "dictionaryHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contextHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "model",
    "sourceProjectionHash",
    "projectionPolicyHash",
    "normalizationContext",
    "dictionaryHash",
    "contextHash"
  ]
}
