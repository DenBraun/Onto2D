{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/structural-flow-transport-response.schema.json",
  "title": "Structural flow transport-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "requestHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "solver": {
      "const": {
        "id": "onto2d-python-flow-transport-reference",
        "version": "1",
        "method": "rational-cost-integer-mass-primal-dual-v1"
      }
    },
    "solutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "edgeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "flow": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 512
              },
              "minItems": 1,
              "maxItems": 16
            },
            "minItems": 1,
            "maxItems": 16
          },
          "sourcePotentials": {
            "type": "array",
            "items": {
              "$ref": "structural-flow-input.schema.json#/$defs/rational"
            },
            "minItems": 1,
            "maxItems": 16
          },
          "targetPotentials": {
            "type": "array",
            "items": {
              "$ref": "structural-flow-input.schema.json#/$defs/rational"
            },
            "minItems": 1,
            "maxItems": 16
          },
          "costNumerator": {
            "$ref": "structural-flow-input.schema.json#/$defs/nonnegativeRational"
          }
        },
        "required": [
          "edgeId",
          "flow",
          "sourcePotentials",
          "targetPotentials",
          "costNumerator"
        ]
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "required": [
    "schemaVersion",
    "requestHash",
    "solver",
    "solutions"
  ]
}
