{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/history-benchmark-observations.schema.json",
  "title": "History Benchmark Observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "units"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unitId",
          "cutoff",
          "present",
          "history"
        ],
        "properties": {
          "unitId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"
          },
          "cutoff": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "present": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time",
              "value"
            ],
            "properties": {
              "time": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"
              }
            }
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "time",
                "value"
              ],
              "properties": {
                "time": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"
                }
              }
            },
            "minItems": 1,
            "maxItems": 1024
          }
        }
      },
      "minItems": 1,
      "maxItems": 256
    }
  }
}
