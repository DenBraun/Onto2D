{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/candidate.schema.json",
  "title": "Onto2D Canonical Candidate",
  "type": "object",
  "required": ["id", "domain", "nodes", "edges", "skeleton", "canonicalForm"],
  "properties": {
    "id": { "$ref": "#/$defs/contentHash" },
    "domain": { "enum": ["profile-quotient", "element-exact", "single-candidate"] },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "skeleton": { "$ref": "#/$defs/contentHash" },
    "canonicalForm": { "$ref": "#/$defs/canonicalForm" }
  },
  "$defs": {
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "attributeValue": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "$ref": "quantity.schema.json" }
      ]
    },
    "attributes": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/attributeValue" }
    },
    "node": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/contentHash" },
        "attrs": { "$ref": "#/$defs/attributes" }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "role"],
      "properties": {
        "from": { "type": "integer", "minimum": 0 },
        "to": { "type": "integer", "minimum": 0 },
        "role": { "type": "string", "minLength": 1 },
        "attrs": { "$ref": "#/$defs/attributes" }
      },
      "additionalProperties": false
    },
    "canonicalForm": {
      "type": "object",
      "required": ["schemaVersion", "bytesBase64", "hash"],
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1 },
        "bytesBase64": { "type": "string", "contentEncoding": "base64" },
        "hash": { "$ref": "#/$defs/contentHash" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
