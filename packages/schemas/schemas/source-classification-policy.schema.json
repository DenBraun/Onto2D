{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/source-classification-policy.schema.json",
  "title": "Onto2D Frozen Source Classification Policy",
  "type": "object",
  "required": [
    "schemaVersion",
    "freezer",
    "version",
    "authorship",
    "exposure",
    "visibleFields",
    "forbiddenInputs",
    "relationKinds",
    "conflictRule",
    "riskPolicy",
    "policyHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "freezer": { "const": "source-classification-policy-v1" },
    "version": { "$ref": "#/$defs/text" },
    "authorship": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "minimumIndependentClassifiers", "adjudicationRule"],
          "properties": {
            "mode": { "const": "human-independent" },
            "minimumIndependentClassifiers": { "type": "integer", "minimum": 2, "maximum": 100 },
            "adjudicationRule": { "$ref": "#/$defs/text" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "classifier", "adjudicationRule"],
          "properties": {
            "mode": { "const": "deterministic-precommitted" },
            "classifier": {
              "type": "object",
              "required": ["id", "version"],
              "properties": {
                "id": { "$ref": "#/$defs/identifier" },
                "version": { "$ref": "#/$defs/identifier" }
              },
              "additionalProperties": false
            },
            "adjudicationRule": { "$ref": "#/$defs/text" }
          },
          "additionalProperties": false
        }
      ]
    },
    "exposure": {
      "type": "object",
      "required": ["status", "declaration", "sccAwareMaterialSeenBeforeFreeze"],
      "properties": {
        "status": { "$ref": "#/$defs/exposure" },
        "declaration": { "$ref": "#/$defs/text" },
        "sccAwareMaterialSeenBeforeFreeze": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "visibleFields": { "$ref": "#/$defs/visibleFieldSet" },
    "forbiddenInputs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cycle-visualization",
          "desired-topology",
          "quotient-acyclicity-effect",
          "scc-membership"
        ]
      }
    },
    "relationKinds": {
      "type": "object",
      "required": [
        "generative",
        "constitutive",
        "intra-closure-support",
        "evidential",
        "descriptive",
        "regulatory-feedback"
      ],
      "properties": {
        "generative": { "$ref": "#/$defs/relationRule" },
        "constitutive": { "$ref": "#/$defs/relationRule" },
        "intra-closure-support": { "$ref": "#/$defs/relationRule" },
        "evidential": { "$ref": "#/$defs/relationRule" },
        "descriptive": { "$ref": "#/$defs/relationRule" },
        "regulatory-feedback": { "$ref": "#/$defs/relationRule" }
      },
      "additionalProperties": false
    },
    "conflictRule": { "$ref": "#/$defs/text" },
    "riskPolicy": {
      "type": "object",
      "required": [
        "maximumClassificationDisagreementRatio",
        "maximumDescriptiveResolutionShare",
        "maximumPostUnblindingReclassificationShare",
        "acceptedBlindness"
      ],
      "properties": {
        "maximumClassificationDisagreementRatio": { "$ref": "#/$defs/ratio" },
        "maximumDescriptiveResolutionShare": { "$ref": "#/$defs/ratio" },
        "maximumPostUnblindingReclassificationShare": { "$ref": "#/$defs/ratio" },
        "acceptedBlindness": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/exposure" }
        }
      },
      "additionalProperties": false
    },
    "policyHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
    "textSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "visibleField": {
      "enum": [
        "causal-directions",
        "dependency-type",
        "interaction-modes",
        "necessity",
        "ontological-role",
        "parent-code",
        "quantization",
        "source",
        "source-text",
        "statement",
        "target",
        "weight"
      ]
    },
    "visibleFieldSet": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/visibleField" },
      "allOf": [
        { "contains": { "const": "source" } },
        { "contains": { "const": "target" } }
      ]
    },
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "exposure": {
      "enum": ["prospective-blind", "deterministic-precommitted", "historically-exposed"]
    },
    "relationRule": {
      "type": "object",
      "required": [
        "decisionQuestion",
        "necessaryObservations",
        "sufficientObservations",
        "inclusions",
        "exclusions",
        "counterexamples"
      ],
      "properties": {
        "decisionQuestion": { "$ref": "#/$defs/text" },
        "necessaryObservations": { "$ref": "#/$defs/textSet" },
        "sufficientObservations": { "$ref": "#/$defs/textSet" },
        "inclusions": { "$ref": "#/$defs/textSet" },
        "exclusions": { "$ref": "#/$defs/textSet" },
        "counterexamples": { "$ref": "#/$defs/textSet" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
