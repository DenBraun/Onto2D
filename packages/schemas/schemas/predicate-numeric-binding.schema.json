{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/predicate-numeric-binding.schema.json",
  "title": "Onto2D Predicate Numeric Policy Binding",
  "type": "object",
  "required": [
    "schemaVersion",
    "binder",
    "bindingHash",
    "predicatePlanHash",
    "expressionHash",
    "numericPolicy",
    "operations"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "binder": { "const": "predicate-numeric-binding-v1" },
    "bindingHash": { "$ref": "#/$defs/hash" },
    "predicatePlanHash": { "$ref": "#/$defs/hash" },
    "expressionHash": { "$ref": "#/$defs/hash" },
    "numericPolicy": {
      "type": "object",
      "required": ["arithmetic", "precision", "roundingBoundary", "summation", "quantityComparison"],
      "properties": {
        "arithmetic": { "const": "decimal-rational-v1" },
        "precision": { "$ref": "precision-policy.schema.json" },
        "roundingBoundary": { "const": "value-expression-result-v1" },
        "summation": {
          "type": "object",
          "required": ["algorithm", "termOrder"],
          "properties": {
            "algorithm": { "enum": ["exact-decimal", "compensated-binary64"] },
            "termOrder": { "const": "canonical-selection-order-v1" }
          },
          "additionalProperties": false
        },
        "quantityComparison": {
          "type": "object",
          "required": ["version", "semanticPolicy", "toleranceCombination", "boundary"],
          "properties": {
            "version": { "const": "declared-max-tolerance-v1" },
            "semanticPolicy": { "enum": ["require-equal", "ignore"] },
            "toleranceCombination": { "const": "maximum-declared-bound-v1" },
            "boundary": { "const": "closed" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "operations": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "operation", "policyRefs"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\$(?:\\.[A-Za-z]+(?:\\[[0-9]+\\])?)*$"
          },
          "operation": {
            "enum": [
              "value-add",
              "value-multiply",
              "value-sum",
              "numeric-compare",
              "quantity-compare",
              "balance",
              "stability-threshold"
            ]
          },
          "policyRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["arithmetic", "precision", "quantityComparison", "summation"]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
