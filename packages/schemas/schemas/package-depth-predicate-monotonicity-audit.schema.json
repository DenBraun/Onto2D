{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-depth-predicate-monotonicity-audit.schema.json",
  "title": "Onto2D Depth-Aware Package Predicate Monotonicity Audit",
  "type": "object",
  "required": [
    "schemaVersion",
    "auditor",
    "scope",
    "packageId",
    "rulesHash",
    "bindingHash",
    "binding",
    "runConfigHash",
    "targetDepth",
    "sourcePopulationHash",
    "seed",
    "policy",
    "samplesPerPredicate",
    "universe",
    "results",
    "counts",
    "status",
    "auditHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "auditor": { "const": "package-depth-predicate-monotonicity-auditor-v1" },
    "scope": { "const": "complete-depth-aware-canonical-universe-v1" },
    "packageId": { "$ref": "#/$defs/hash" },
    "rulesHash": { "$ref": "#/$defs/hash" },
    "bindingHash": { "$ref": "#/$defs/hash" },
    "binding": { "$ref": "package-depth-candidate-binding.schema.json" },
    "runConfigHash": { "$ref": "#/$defs/hash" },
    "targetDepth": { "$ref": "#/$defs/depth" },
    "sourcePopulationHash": { "$ref": "#/$defs/hash" },
    "seed": { "$ref": "#/$defs/id" },
    "policy": {
      "$ref": "package-predicate-monotonicity-audit.schema.json#/$defs/policy"
    },
    "samplesPerPredicate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "universe": { "$ref": "#/$defs/universe" },
    "results": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "package-predicate-monotonicity-audit.schema.json#/$defs/result"
      }
    },
    "counts": {
      "$ref": "package-predicate-monotonicity-audit.schema.json#/$defs/counts"
    },
    "status": {
      "enum": ["not-applicable", "passed", "failed", "indeterminate"]
    },
    "auditHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:\\S|\\S(?:.*\\S)?)$"
    },
    "depth": { "type": "integer", "minimum": 1, "maximum": 64 },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "universe": {
      "type": "object",
      "required": [
        "generator",
        "candidateCount",
        "extensionFrameSize",
        "universeHash"
      ],
      "properties": {
        "generator": { "const": "package-depth-candidate-generator-v3" },
        "candidateCount": { "$ref": "#/$defs/count" },
        "extensionFrameSize": { "$ref": "#/$defs/count" },
        "universeHash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
