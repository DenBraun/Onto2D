{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-generator-frontier-audit.schema.json",
  "title": "Onto2D Package Generator-Frontier Audit",
  "type": "object",
  "required": [
    "schemaVersion",
    "auditor",
    "scope",
    "packageId",
    "rulesHash",
    "bindingHash",
    "binding",
    "runConfigHash",
    "canonicalAuditHash",
    "seed",
    "policy",
    "policySupport",
    "samplesPerPredicate",
    "universe",
    "profileExtensionUniverse",
    "results",
    "counts",
    "status",
    "frontierAuditHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "auditor": { "const": "package-generator-frontier-auditor-v1" },
    "scope": { "const": "complete-depth-one-raw-edge-group-frontiers-v1" },
    "packageId": { "$ref": "#/$defs/hash" },
    "rulesHash": { "$ref": "#/$defs/hash" },
    "bindingHash": { "$ref": "#/$defs/hash" },
    "binding": { "$ref": "package-candidate-binding.schema.json" },
    "runConfigHash": { "$ref": "#/$defs/hash" },
    "canonicalAuditHash": { "$ref": "#/$defs/hash" },
    "seed": { "$ref": "#/$defs/id" },
    "policy": { "$ref": "#/$defs/policy" },
    "policySupport": { "const": "supported" },
    "samplesPerPredicate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "universe": { "$ref": "#/$defs/universe" },
    "profileExtensionUniverse": {
      "allOf": [
        { "$ref": "#/$defs/profileExtensionUniverse" },
        { "properties": { "kind": { "const": "edge-group" } } }
      ]
    },
    "results": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/result" }
    },
    "counts": { "$ref": "#/$defs/counts" },
    "status": {
      "enum": ["not-applicable", "passed", "failed", "indeterminate"]
    },
    "frontierAuditHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:\\S|\\S(?:.*\\S)?)$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "policy": {
      "type": "object",
      "required": [
        "extensionModel",
        "samplingAlgorithm",
        "replacement",
        "counterexampleRule",
        "proofInterpretation",
        "connectivityPolicy"
      ],
      "properties": {
        "extensionModel": { "const": "complete-node-edge-group-frontier-v1" },
        "samplingAlgorithm": { "const": "sha256-rejection-counter-v1" },
        "replacement": { "const": "with-replacement" },
        "counterexampleRule": { "const": "frontier-fail-extension-pass-v1" },
        "proofInterpretation": {
          "const": "falsification-only-static-proof-required-v1"
        },
        "connectivityPolicy": {
          "const": "directed-strong-frontier-satisfaction-required-v1"
        }
      },
      "additionalProperties": false
    },
    "universe": {
      "type": "object",
      "required": [
        "enumerator",
        "canonicalCandidateCount",
        "rawExtensionCandidates",
        "extensionFrameSize",
        "canonicalUniverseHash",
        "frontierFrameHash"
      ],
      "properties": {
        "enumerator": { "const": "decorated-candidate-enumerator-v5" },
        "canonicalCandidateCount": { "$ref": "#/$defs/count" },
        "rawExtensionCandidates": { "$ref": "#/$defs/count" },
        "extensionFrameSize": { "$ref": "#/$defs/count" },
        "canonicalUniverseHash": { "$ref": "#/$defs/hash" },
        "frontierFrameHash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "profileExtensionUniverse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "evaluator",
        "bindingHash",
        "policy",
        "status",
        "kind",
        "rawExtensionCandidates",
        "compatibleRawExtensionCandidates",
        "excludedRawExtensionCandidates",
        "compatibleCanonicalCandidateCount",
        "compatibleCanonicalCandidateHash",
        "frontiers",
        "censusHash",
        "extensionUniverseHash"
      ],
      "properties": {
        "schemaVersion": { "const": "1" },
        "evaluator": { "const": "package-profile-pruning-extension-census-v1" },
        "bindingHash": { "$ref": "#/$defs/hash" },
        "policy": { "enum": ["post-admission-v1", "profile-slot-gate-v1"] },
        "status": { "enum": ["not-run", "complete"] },
        "kind": { "enum": ["edge-group", "node-assignment"] },
        "rawExtensionCandidates": { "$ref": "#/$defs/count" },
        "compatibleRawExtensionCandidates": { "$ref": "#/$defs/count" },
        "excludedRawExtensionCandidates": { "$ref": "#/$defs/count" },
        "compatibleCanonicalCandidateCount": { "$ref": "#/$defs/count" },
        "compatibleCanonicalCandidateHash": { "$ref": "#/$defs/hash" },
        "frontiers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profileExtensionFrontier" }
        },
        "censusHash": { "$ref": "#/$defs/hash" },
        "extensionUniverseHash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["policy"],
            "properties": {
              "policy": { "const": "profile-slot-gate-v1" }
            }
          },
          "then": { "properties": { "status": { "const": "complete" } } },
          "else": { "properties": { "status": { "const": "not-run" } } }
        }
      ]
    },
    "profileExtensionFrontier": {
      "type": "object",
      "required": [
        "frontierKey",
        "compatibleRawCandidates",
        "excludedRawCandidates"
      ],
      "properties": {
        "frontierKey": { "$ref": "#/$defs/hash" },
        "compatibleRawCandidates": { "$ref": "#/$defs/count" },
        "excludedRawCandidates": { "$ref": "#/$defs/count" }
      },
      "additionalProperties": false
    },
    "resultCounts": {
      "type": "object",
      "required": [
        "attempted",
        "partialFailures",
        "extensionPasses",
        "persistentFailuresDetected",
        "counterexamples"
      ],
      "properties": {
        "attempted": { "$ref": "#/$defs/count" },
        "partialFailures": { "$ref": "#/$defs/count" },
        "extensionPasses": { "$ref": "#/$defs/count" },
        "persistentFailuresDetected": { "$ref": "#/$defs/count" },
        "counterexamples": { "$ref": "#/$defs/count" }
      },
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "required": [
        "sampleOrdinal",
        "frameIndex",
        "streamDraws",
        "observedExtensionOrdinal",
        "rawCandidateOrdinal",
        "extensionCandidateId",
        "skeletonId",
        "completedEdgeGroups",
        "totalEdgeGroups",
        "edgeGroupCounts",
        "partialEdgeCount",
        "extensionEdgeCount",
        "partialGraphHash",
        "partialEvaluationHash",
        "extensionEvaluationHash",
        "diagnosticEvaluationHash",
        "partialOutcome",
        "extensionOutcome",
        "persistentFailureDetected",
        "counterexample"
      ],
      "properties": {
        "sampleOrdinal": { "$ref": "#/$defs/count" },
        "frameIndex": { "$ref": "#/$defs/count" },
        "streamDraws": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "observedExtensionOrdinal": { "$ref": "#/$defs/count" },
        "rawCandidateOrdinal": { "$ref": "#/$defs/count" },
        "extensionCandidateId": { "$ref": "#/$defs/hash" },
        "skeletonId": { "$ref": "#/$defs/hash" },
        "completedEdgeGroups": { "$ref": "#/$defs/count" },
        "totalEdgeGroups": { "$ref": "#/$defs/count" },
        "edgeGroupCounts": {
          "type": "array",
          "items": { "$ref": "#/$defs/count" }
        },
        "partialEdgeCount": { "$ref": "#/$defs/count" },
        "extensionEdgeCount": { "$ref": "#/$defs/count" },
        "partialGraphHash": { "$ref": "#/$defs/hash" },
        "partialEvaluationHash": { "$ref": "#/$defs/hash" },
        "extensionEvaluationHash": { "$ref": "#/$defs/hash" },
        "diagnosticEvaluationHash": { "$ref": "#/$defs/hash" },
        "partialOutcome": { "enum": ["pass", "fail", "indeterminate"] },
        "extensionOutcome": { "enum": ["pass", "fail", "indeterminate"] },
        "persistentFailureDetected": { "type": "boolean" },
        "counterexample": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "predicateId",
        "predicatePlanHash",
        "pruningEligibility",
        "canonicalAuditStatus",
        "runtimeSupport",
        "requestedSamples",
        "frameSize",
        "samples",
        "counts",
        "status",
        "pruningEligible"
      ],
      "properties": {
        "predicateId": { "$ref": "#/$defs/id" },
        "predicatePlanHash": { "$ref": "#/$defs/hash" },
        "pruningEligibility": {
          "enum": [
            "disabled",
            "static-proven",
            "blocked-unproven",
            "blocked-partial-data"
          ]
        },
        "canonicalAuditStatus": {
          "enum": [
            "passed",
            "failed",
            "unsupported",
            "no-extensions",
            "no-samples",
            "not-declared"
          ]
        },
        "runtimeSupport": {
          "enum": ["graph-complete-and-partial-v1", "unsupported"]
        },
        "requestedSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "frameSize": { "$ref": "#/$defs/count" },
        "samples": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sample" }
        },
        "counts": { "$ref": "#/$defs/resultCounts" },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unsupported-runtime",
            "no-frontiers",
            "no-samples"
          ]
        },
        "pruningEligible": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": [
        "declaredPredicates",
        "runtimeSupportedPredicates",
        "passedPredicates",
        "failedPredicates",
        "indeterminatePredicates",
        "authorizedPlans",
        "attemptedSamples",
        "counterexamples"
      ],
      "properties": {
        "declaredPredicates": { "$ref": "#/$defs/count" },
        "runtimeSupportedPredicates": { "$ref": "#/$defs/count" },
        "passedPredicates": { "$ref": "#/$defs/count" },
        "failedPredicates": { "$ref": "#/$defs/count" },
        "indeterminatePredicates": { "$ref": "#/$defs/count" },
        "authorizedPlans": { "$ref": "#/$defs/count" },
        "attemptedSamples": { "$ref": "#/$defs/count" },
        "counterexamples": { "$ref": "#/$defs/count" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
