{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-recursive-pruned-candidate-generation.schema.json",
  "title": "Onto2D Audited Recursive-Pruning Candidate Generation",
  "type": "object",
  "required": [
    "schemaVersion",
    "generator",
    "packageId",
    "rulesHash",
    "bindingHash",
    "runConfigHash",
    "canonicalAuditHash",
    "frontierAuditHash",
    "binding",
    "enumeration",
    "profileComposition",
    "pruning",
    "conformance",
    "generationHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "generator": { "const": "package-recursive-pruned-candidate-generator-v1" },
    "packageId": { "$ref": "#/$defs/hash" },
    "rulesHash": { "$ref": "#/$defs/hash" },
    "bindingHash": { "$ref": "#/$defs/hash" },
    "runConfigHash": { "$ref": "#/$defs/hash" },
    "canonicalAuditHash": { "$ref": "#/$defs/hash" },
    "frontierAuditHash": { "$ref": "#/$defs/hash" },
    "binding": { "$ref": "package-candidate-binding.schema.json" },
    "enumeration": {
      "allOf": [
        { "$ref": "candidate-enumeration-result.schema.json" },
        {
          "properties": {
            "status": { "const": "complete" },
            "interpretable": { "const": true }
          }
        }
      ]
    },
    "profileComposition": {
      "$ref": "package-profile-composition.schema.json"
    },
    "pruning": { "$ref": "#/$defs/pruning" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "generationHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:\\S|\\S(?:.*\\S)?)$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pruning": {
      "type": "object",
      "required": [
        "strategy",
        "transcriptHash",
        "frontierAuthorizedPredicateIds",
        "preAdmissionAuthorizedPredicateIds",
        "prunedFrontiers",
        "counts"
      ],
      "properties": {
        "strategy": { "const": "audited-edge-group-subtree-pruning-v1" },
        "transcriptHash": { "$ref": "#/$defs/hash" },
        "frontierAuthorizedPredicateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "preAdmissionAuthorizedPredicateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "prunedFrontiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/prunedFrontier" }
        },
        "counts": { "$ref": "#/$defs/pruningCounts" }
      },
      "additionalProperties": false
    },
    "prunedFrontier": {
      "type": "object",
      "required": [
        "frontierOrdinal", "partialGraph", "decision", "profileExtension"
      ],
      "properties": {
        "frontierOrdinal": { "$ref": "#/$defs/count" },
        "partialGraph": {
          "allOf": [
            { "$ref": "partial-predicate-graph.schema.json" },
            { "properties": { "nodesComplete": { "const": true } } }
          ]
        },
        "decision": { "$ref": "package-generator-frontier-decision.schema.json" },
        "profileExtension": {
          "$ref": "package-generator-frontier-audit.schema.json#/$defs/profileExtensionFrontier"
        }
      },
      "additionalProperties": false
    },
    "pruningCounts": {
      "type": "object",
      "required": [
        "evaluatedFrontiers",
        "frontierControllerDecisions",
        "authorizedFrontiers",
        "skippedRawCandidates",
        "skippedProfileCompatibleRawCandidates",
        "skippedProfileExcludedRawCandidates",
        "evaluatedCompleteRawCandidates",
        "evaluatedCompletePrefixes",
        "preAdmissionControllerDecisions",
        "preAdmissionAuthorizedDecisions",
        "visitedDecorationStates",
        "referenceDecorationStates",
        "skippedDecorationStates"
      ],
      "properties": {
        "evaluatedFrontiers": { "$ref": "#/$defs/count" },
        "frontierControllerDecisions": { "$ref": "#/$defs/count" },
        "authorizedFrontiers": { "$ref": "#/$defs/count" },
        "skippedRawCandidates": { "$ref": "#/$defs/count" },
        "skippedProfileCompatibleRawCandidates": { "$ref": "#/$defs/count" },
        "skippedProfileExcludedRawCandidates": { "$ref": "#/$defs/count" },
        "evaluatedCompleteRawCandidates": { "$ref": "#/$defs/count" },
        "evaluatedCompletePrefixes": { "$ref": "#/$defs/count" },
        "preAdmissionControllerDecisions": { "$ref": "#/$defs/count" },
        "preAdmissionAuthorizedDecisions": { "$ref": "#/$defs/count" },
        "visitedDecorationStates": { "$ref": "#/$defs/count" },
        "referenceDecorationStates": { "$ref": "#/$defs/count" },
        "skippedDecorationStates": { "$ref": "#/$defs/count" }
      },
      "additionalProperties": false
    },
    "conformance": {
      "type": "object",
      "required": [
        "status",
        "preAdmissionGenerationHash",
        "recursiveRetainedStoreHash",
        "preAdmissionRetainedStoreHash",
        "pruningDisabledCanonicalCandidates",
        "preAdmissionCanonicalCandidates",
        "recursiveCanonicalCandidates",
        "eligible",
        "indeterminate"
      ],
      "properties": {
        "status": { "const": "passed" },
        "preAdmissionGenerationHash": { "$ref": "#/$defs/hash" },
        "recursiveRetainedStoreHash": { "$ref": "#/$defs/hash" },
        "preAdmissionRetainedStoreHash": { "$ref": "#/$defs/hash" },
        "pruningDisabledCanonicalCandidates": { "$ref": "#/$defs/count" },
        "preAdmissionCanonicalCandidates": { "$ref": "#/$defs/count" },
        "recursiveCanonicalCandidates": { "$ref": "#/$defs/count" },
        "eligible": { "$ref": "#/$defs/resultSet" },
        "indeterminate": { "$ref": "#/$defs/resultSet" }
      },
      "additionalProperties": false
    },
    "resultSet": {
      "type": "object",
      "required": [
        "candidateCount",
        "pruningDisabledHash",
        "pruningEnabledHash"
      ],
      "properties": {
        "candidateCount": { "$ref": "#/$defs/count" },
        "pruningDisabledHash": { "$ref": "#/$defs/hash" },
        "pruningEnabledHash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
