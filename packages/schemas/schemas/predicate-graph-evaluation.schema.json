{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/predicate-graph-evaluation.schema.json",
  "title": "Onto2D Graph Predicate Evaluation",
  "type": "object",
  "required": [
    "schemaVersion",
    "evaluator",
    "predicatePlanHash",
    "candidateId",
    "graphPolicy",
    "outcome",
    "witnesses",
    "evaluationHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "evaluator": { "const": "graph-predicate-evaluator-v1" },
    "predicatePlanHash": { "$ref": "#/$defs/hash" },
    "candidateId": { "$ref": "#/$defs/hash" },
    "graphPolicy": { "$ref": "graph-policy.schema.json" },
    "outcome": { "$ref": "#/$defs/outcome" },
    "witnesses": {
      "type": "array",
      "maxItems": 60000,
      "items": { "$ref": "#/$defs/witness" }
    },
    "evaluationHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "outcome": { "enum": ["pass", "fail", "indeterminate"] },
    "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "indexList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/index" }
    },
    "normalizedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:\\S|\\S(?:.*\\S)?)$"
    },
    "witness": {
      "type": "object",
      "required": ["expressionPath", "operator", "outcome"],
      "properties": {
        "expressionPath": {
          "type": "string",
          "pattern": "^\\$(?:\\.(?:arg|args\\[[0-9]+\\]))*$"
        },
        "operator": {
          "enum": [
            "degree",
            "cycleExists",
            "connected",
            "componentCount",
            "pathExists",
            "countRole"
          ]
        },
        "outcome": { "$ref": "#/$defs/outcome" },
        "nodeIndexes": { "$ref": "#/$defs/indexList" },
        "edgeIndexes": { "$ref": "#/$defs/indexList" },
        "components": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/indexList" }
        },
        "count": { "$ref": "#/$defs/index" },
        "expectedCount": { "$ref": "#/$defs/index" },
        "min": { "$ref": "#/$defs/index" },
        "max": { "$ref": "#/$defs/index" },
        "role": { "$ref": "#/$defs/normalizedString" },
        "roles": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/normalizedString" }
        },
        "projection": {
          "enum": ["directed", "undirected-simple", "undirected-multigraph"]
        },
        "reason": {
          "enum": [
            "selector-empty",
            "no-matching-cycle",
            "no-matching-path",
            "partial-connectivity-repairable"
          ]
        }
      },
      "additionalProperties": false
    },
    "nestedWitness": {
      "type": "object",
      "required": ["expressionPath", "operator", "outcome"],
      "properties": {
        "expressionPath": {
          "type": "string",
          "pattern": "^\\$(?:\\.(?:arg|args\\[[0-9]+\\]|predicate))*$"
        },
        "operator": {
          "enum": [
            "degree",
            "cycleExists",
            "connected",
            "componentCount",
            "pathExists",
            "countRole"
          ]
        },
        "outcome": { "$ref": "#/$defs/outcome" },
        "nodeIndexes": { "$ref": "#/$defs/indexList" },
        "edgeIndexes": { "$ref": "#/$defs/indexList" },
        "components": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/indexList" }
        },
        "count": { "$ref": "#/$defs/index" },
        "expectedCount": { "$ref": "#/$defs/index" },
        "min": { "$ref": "#/$defs/index" },
        "max": { "$ref": "#/$defs/index" },
        "role": { "$ref": "#/$defs/normalizedString" },
        "roles": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/normalizedString" }
        },
        "projection": {
          "enum": ["directed", "undirected-simple", "undirected-multigraph"]
        },
        "reason": {
          "enum": [
            "selector-empty",
            "no-matching-cycle",
            "no-matching-path",
            "partial-connectivity-repairable"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
