{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/semantic-manifest.schema.json",
  "title": "Onto2D Loaded-Package Semantic Manifest",
  "type": "object",
  "required": ["schemaVersion", "kernelVersion", "packageId", "rulesHash", "depthBasis", "identityPolicyHash"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "kernelVersion": { "type": "string", "minLength": 1 },
    "packageId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "rulesHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "depthBasis": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "identityPolicyHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
