{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-run-artifact-materialization.schema.json",
  "title": "Onto2D Package Run Artifact Materialization",
  "type": "object",
  "required": [
    "schemaVersion",
    "materializer",
    "bundleHash",
    "ref",
    "bytesBase64",
    "materializationHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "materializer": { "const": "package-run-artifact-materializer-v1" },
    "bundleHash": { "$ref": "#/$defs/hash" },
    "ref": { "$ref": "artifact-ref.schema.json" },
    "bytesBase64": {
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "materializationHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
