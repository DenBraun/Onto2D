{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/v1/package-level-boundary-report.schema.json",
  "title": "Onto2D Bounded Level-Boundary Report",
  "type": "object",
  "required": [
    "schemaVersion", "detector", "scope", "packageId", "rulesHash",
    "depthBasis", "requestedDepths", "runConfigHash", "policy",
    "detectionPolicy", "comparisonLadders", "points",
    "candidateMinimumDepths", "detectedDepths", "declaredDepths", "status",
    "interpretation", "notes", "boundaryHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "detector": { "const": "package-level-boundary-detector-v1" },
    "scope": { "const": "bounded-profile-collapse-minima-v1" },
    "packageId": { "$ref": "#/$defs/hash" },
    "rulesHash": { "$ref": "#/$defs/hash" },
    "depthBasis": { "$ref": "#/$defs/hash" },
    "requestedDepths": { "$ref": "#/$defs/depth" },
    "runConfigHash": { "$ref": "#/$defs/hash" },
    "policy": { "$ref": "#/$defs/policy" },
    "detectionPolicy": { "$ref": "run-config.schema.json#/$defs/levelBoundaryPolicy" },
    "comparisonLadders": {
      "type": "object",
      "required": ["elementExact", "profileQuotient"],
      "properties": {
        "elementExact": { "$ref": "#/$defs/hash" },
        "profileQuotient": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/point" }
    },
    "candidateMinimumDepths": { "$ref": "#/$defs/depthSet" },
    "detectedDepths": { "$ref": "#/$defs/depthSet" },
    "declaredDepths": { "$ref": "#/$defs/depthSet" },
    "status": { "enum": ["complete", "truncated", "indeterminate"] },
    "interpretation": { "$ref": "#/$defs/interpretation" },
    "notes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "boundaryHash": { "$ref": "#/$defs/hash" }
  },
  "oneOf": [
    {
      "properties": {
        "status": { "const": "complete" },
        "interpretation": {
          "properties": {
            "status": { "const": "complete" },
            "reasons": { "maxItems": 0 }
          }
        }
      }
    },
    {
      "properties": {
        "status": { "const": "truncated" },
        "interpretation": {
          "properties": {
            "status": { "const": "truncated" },
            "reasons": {
              "prefixItems": [{ "const": "collapse-truncated" }],
              "minItems": 1,
              "maxItems": 1
            }
          }
        }
      }
    },
    {
      "properties": {
        "status": { "const": "indeterminate" },
        "interpretation": {
          "properties": {
            "status": { "const": "indeterminate" },
            "reasons": {
              "prefixItems": [{ "const": "collapse-indeterminate" }],
              "minItems": 1,
              "maxItems": 1
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "depth": { "type": "integer", "minimum": 1, "maximum": 64 },
    "depthSet": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/depth" }
    },
    "levelOrNull": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        { "type": "null" }
      ]
    },
    "policy": {
      "type": "object",
      "required": ["transitionOrder", "intervalMembership", "minima", "noIntervals", "declaration", "mutation"],
      "properties": {
        "transitionOrder": { "const": "ascending-target-depth-v1" },
        "intervalMembership": { "const": "target-depth-inclusive-v1" },
        "minima": { "const": "within-tie-tolerance-and-maximum-error-v1" },
        "noIntervals": { "const": "report-global-candidate-minima-without-detection-v1" },
        "declaration": { "const": "uniform-coordinate-or-run-ontology-target-v1" },
        "mutation": { "const": "never-rewrite-declared-coordinates-v1" }
      },
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "required": [
        "fromDepth", "toDepth", "depthBasis", "collapseHash",
        "collapseError", "declaredLevelBefore", "declaredLevelAfter",
        "declaredBoundary", "status", "verdict", "candidateMinimum",
        "detectedBoundary", "matchesDeclaration"
      ],
      "properties": {
        "fromDepth": { "type": "integer", "minimum": 0, "maximum": 63 },
        "toDepth": { "$ref": "#/$defs/depth" },
        "depthBasis": { "$ref": "#/$defs/hash" },
        "collapseHash": { "$ref": "#/$defs/hash" },
        "collapseError": {
          "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "declaredLevelBefore": { "$ref": "#/$defs/levelOrNull" },
        "declaredLevelAfter": { "$ref": "#/$defs/levelOrNull" },
        "declaredBoundary": { "type": "boolean" },
        "status": { "enum": ["complete", "truncated", "indeterminate"] },
        "verdict": { "enum": ["equivalent", "counterexample", "indeterminate"] },
        "candidateMinimum": { "type": "boolean" },
        "detectedBoundary": { "type": "boolean" },
        "matchesDeclaration": {
          "oneOf": [{ "type": "boolean" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "interpretation": {
      "type": "object",
      "required": ["status", "reasons"],
      "properties": {
        "status": { "enum": ["complete", "truncated", "indeterminate"] },
        "reasons": {
          "type": "array",
          "maxItems": 1,
          "items": { "enum": ["collapse-truncated", "collapse-indeterminate"] }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
