{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/proposals/model-pack-v2/chunk.schema.json",
  "title": "Proposed Model Pack v2 semantic chunk (not a published format)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "collection",
    "offset",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "collection": {
      "enum": [
        "nodes",
        "edges"
      ]
    },
    "offset": {
      "$ref": "#/$defs/count"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "collection": {
            "const": "edges"
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/edge"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "not": {
        "enum": [
          "__proto__",
          "constructor",
          "prototype"
        ]
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "node": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/identifier"
        }
      },
      "additionalProperties": true
    }
  }
}
