{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/proposals/model-pack-v2/manifest.schema.json",
  "title": "Proposed Model Pack v2 manifest (not a published format)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "format",
    "formatVersion",
    "model",
    "compatibility",
    "source",
    "semantics",
    "layout",
    "rootHash",
    "manifestHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "format": {
      "const": "onto2d-model-pack"
    },
    "formatVersion": {
      "const": "2"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "status": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineApiVersion",
        "modelPackFormatVersion"
      ],
      "properties": {
        "engineApiVersion": {
          "const": "1"
        },
        "modelPackFormatVersion": {
          "const": "2"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "files"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "hash"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "hash": {
                "$ref": "#/$defs/hash"
              }
            }
          }
        },
        "auditHash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges",
        "dictionaries"
      ],
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "hash"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "hash": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        "edges": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "hash"
          ],
          "properties": {
            "count": {
              "$ref": "#/$defs/count"
            },
            "hash": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        "dictionaries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hash"
          ],
          "properties": {
            "hash": {
              "$ref": "#/$defs/hash"
            }
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges",
        "dictionaries",
        "indexes",
        "artifacts"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "byteLength",
              "hash",
              "offset",
              "count",
              "firstId",
              "lastId"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^semantic/nodes/[0-9]{8}\\.json$"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1073741824
              },
              "hash": {
                "$ref": "#/$defs/hash"
              },
              "offset": {
                "$ref": "#/$defs/count"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "firstId": {
                "$ref": "#/$defs/identifier"
              },
              "lastId": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "byteLength",
              "hash",
              "offset",
              "count",
              "firstId",
              "lastId"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^semantic/edges/[0-9]{8}\\.json$"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1073741824
              },
              "hash": {
                "$ref": "#/$defs/hash"
              },
              "offset": {
                "$ref": "#/$defs/count"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "firstId": {
                "$ref": "#/$defs/identifier"
              },
              "lastId": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        },
        "dictionaries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "byteLength",
            "hash"
          ],
          "properties": {
            "path": {
              "const": "semantic/dictionaries.json"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1073741824
            },
            "hash": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        "indexes": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "byteLength",
              "hash",
              "id"
            ],
            "properties": {
              "path": {
                "enum": [
                  "indexes/by-id.json",
                  "indexes/parents.json",
                  "indexes/children.json",
                  "indexes/levels.json",
                  "indexes/phases.json",
                  "indexes/type-roles.json",
                  "indexes/scientific-status.json"
                ]
              },
              "byteLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1073741824
              },
              "hash": {
                "$ref": "#/$defs/hash"
              },
              "id": {
                "enum": [
                  "byId",
                  "parents",
                  "children",
                  "levels",
                  "phases",
                  "typeRoles",
                  "scientificStatus"
                ]
              }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "byteLength",
              "hash",
              "id",
              "profile"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^artifacts/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$",
                "maxLength": 79
              },
              "byteLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1073741824
              },
              "hash": {
                "$ref": "#/$defs/hash"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 64
              },
              "profile": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    "rootHash": {
      "$ref": "#/$defs/hash"
    },
    "manifestHash": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "not": {
        "enum": [
          "__proto__",
          "constructor",
          "prototype"
        ]
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
