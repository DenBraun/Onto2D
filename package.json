{
  "name": "onto2d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.d.ts",
  "sideEffects": false,
  "description": "Ontology-backed tooling and the staged Onto2D closure-kernel workspace.",
  "license": "MIT",
  "repository": "github:DenBraun/Onto2D",
  "bugs": {
    "url": "https://github.com/DenBraun/Onto2D/issues"
  },
  "homepage": "https://github.com/DenBraun/Onto2D#readme",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:worker": "node scripts/build-model-pack-worker.mjs",
    "case:level-0": "node cases/level-0-oscillator/run-level-zero-validation-v2.mjs",
    "case:level-0:verify": "node cases/level-0-oscillator/run-level-zero-validation-v2.mjs --verify",
    "case:level-0:v1": "node cases/level-0-oscillator/run-level-zero-validation.mjs",
    "case:level-0:v1:verify": "node cases/level-0-oscillator/run-level-zero-validation.mjs --verify",
    "case:level-0:phase-b": "node cases/level-0-oscillator/run.mjs",
    "case:level-0:phase-b:verify": "node cases/level-0-oscillator/run.mjs --verify",
    "case:level-0:phase-c": "node cases/level-0-oscillator/run-phase-c-preflight.mjs",
    "case:level-0:phase-c:verify": "node cases/level-0-oscillator/run-phase-c-preflight.mjs --verify",
    "case:level-0:objecthood": "node cases/level-0-oscillator/run-phase-c-objecthood.mjs",
    "case:level-0:objecthood:verify": "node cases/level-0-oscillator/run-phase-c-objecthood.mjs --verify",
    "case:level-0:dynamics": "node cases/level-0-oscillator/run-phase-c-dynamics.mjs",
    "case:level-0:dynamics:verify": "node cases/level-0-oscillator/run-phase-c-dynamics.mjs --verify",
    "case:level-0:expanded": "node cases/level-0-oscillator/run-phase-c-expanded-search.mjs",
    "case:level-0:expanded:verify": "node cases/level-0-oscillator/run-phase-c-expanded-search.mjs --verify",
    "case:motifs": "node cases/three-node-motifs/run.mjs",
    "case:motifs:fetch": "node cases/three-node-motifs/scripts/fetch-sources.mjs",
    "case:rdf-mapping": "node cases/rdf-mapping-reference/run.mjs",
    "case:rdf-mapping:verify": "node cases/rdf-mapping-reference/run.mjs --verify",
    "dev:site": "node apps/historical-load-explorer/serve.mjs",
    "dev:explorer": "node apps/historical-load-explorer/serve.mjs",
    "model:causal-emergence": "node models/causal-emergence/build.mjs",
    "model:causal-emergence:verify": "node models/causal-emergence/build.mjs --verify",
    "check": "node scripts/check.mjs",
    "check:catalogue": "node scripts/audit-catalogue.mjs --verify",
    "check:closure": "node scripts/check-kernel-closure.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:goldens": "python3 scripts/reference/generate-conformance-fixtures.py --verify",
    "check:registry": "node scripts/check-model-pack-registry.mjs",
    "check:worker": "node scripts/check-model-pack-worker.mjs",
    "check:schemas": "node scripts/check-schemas.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check:types": "node scripts/check-types.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "test": "node scripts/test.mjs",
    "test:kernel": "node scripts/test.mjs packages/kernel/test",
    "audit:catalogue": "node scripts/audit-catalogue.mjs"
  },
  "dependencies": {
    "@onto2d/canonical-identity-analysis": "0.1.0",
    "@onto2d/engine": "0.1.0",
    "@onto2d/model-pack": "0.1.0",
    "@onto2d/view": "0.1.0"
  },
  "devDependencies": {
    "ajv": "8.18.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
