{
  "name": "onto2d",
  "version": "0.1.0",
  "private": true,
  "description": "Ontology-backed tooling and the staged Onto2D closure-kernel workspace.",
  "license": "MIT",
  "repository": "github:DenBraun/Onto2D",
  "bugs": {
    "url": "https://github.com/DenBraun/Onto2D/issues"
  },
  "homepage": "https://github.com/DenBraun/Onto2D#readme",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "case:motifs": "node cases/three-node-motifs/run.mjs",
    "case:motifs:fetch": "node cases/three-node-motifs/scripts/fetch-sources.mjs",
    "dev:site": "node apps/historical-load-explorer/serve.mjs",
    "dev:explorer": "node apps/historical-load-explorer/serve.mjs",
    "check": "node scripts/check.mjs",
    "check:catalogue": "node scripts/audit-catalogue.mjs --verify",
    "check:closure": "node scripts/check-kernel-closure.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:goldens": "python3 scripts/reference/generate-conformance-fixtures.py --verify",
    "check:schemas": "node scripts/check-schemas.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check:types": "node scripts/check-types.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "test": "node scripts/test.mjs",
    "test:kernel": "node scripts/test.mjs packages/kernel/test",
    "audit:catalogue": "node scripts/audit-catalogue.mjs"
  },
  "devDependencies": {
    "ajv": "8.18.0",
    "typescript": "5.9.3"
  }
}
