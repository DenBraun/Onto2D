        "page 1"
      ],
      "directObservation": false
    },
    {
      "id": "claim-b-group",
      "kind": "scholarly-grouping",
      "summary": "Cx1, Tc2, Ne, He, Ox1, Cx2, Wy, and Pn are analysed as members of the b group, with Hk treated cautiously.",
      "locators": [
        "pages 5-6"
      ],
      "directObservation": false
    },
    {
      "id": "claim-descendants-of-cx2",
      "kind": "copy-relation",
      "summary": "The later Pn and Wy editions are reported as copies of Cx2.",
      "locators": [
        "page 5"
      ],
      "directObservation": false
    },
    {
      "id": "claim-caxton-correction",
      "kind": "multiple-exemplar-transmission",
      "summary": "Cx2 was produced by correcting a copy of Cx1 from a second, better manuscript exemplar before resetting the edition.",
      "locators": [
        "pages 18-19"
      ],
      "directObservation": false
    },
    {
      "id": "claim-correction-profile-207",
      "kind": "published-quantitative-analysis",
      "summary": "A published search reports 207 Cx2-versus-Cx1 differences whose Cx2 readings occur in more than three witnesses; the analysis says the great majority likely came from the better copy.",
      "locators": [
        "pages 19-20"
      ],
      "directObservation": false
    },
    {
      "id": "claim-tree-distortion",
      "kind": "methodological-warning",
      "summary": "Including the Cx2-Pn-Wy trio changes higher-level tree rooting because a tree method attempts to explain lateral readings as vertical descent.",
      "locators": [
        "pages 20-21"
      ],
      "directObservation": false
    },
    {
      "id": "claim-rooting-uncertainty",
      "kind": "uncertainty-boundary",
      "summary": "The published analysis treats central rootings as uncertain and requires tree output to be checked against independent variant analysis.",
      "locators": [
        "pages 20-21"
      ],
      "directObservation": false
    }
  ],
