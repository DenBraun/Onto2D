{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.example/schemas/galactic-archaeology.schema.json",
  "title": "Onto2D Galactic Archaeology case artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "caseVersion",
    "source",
    "methodology",
    "cohort",
    "records",
    "qualityAblation",
    "evidenceAblation",
    "historicalInterpretations",
    "reconstruction",
    "historicalLoad",
    "audit",
    "evidenceBoundary",
    "nonClaims",
    "disclaimer",
    "caseIdentity"
  ],
  "properties": {
    "format": { "const": "onto2d-galactic-archaeology-case" },
    "formatVersion": { "const": "1" },
    "caseVersion": { "const": "gaia-dr3-chemical-cartography-interpretation-v1" },
    "source": {
      "type": "object",
      "required": ["identity", "snapshotIdentity", "snapshotBytes", "release", "retrievedAt", "liveNetworkRequiredByBuild", "tableLocks", "paper", "executedQueryCount", "authoredFiles", "snapshotFiles"],
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "snapshotIdentity": { "$ref": "#/$defs/identity" },
        "snapshotBytes": { "const": 290161 },
        "release": { "const": "Gaia DR3" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "liveNetworkRequiredByBuild": { "const": false },
        "tableLocks": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/tableLock" } },
        "paper": { "$ref": "#/$defs/paper" },
        "executedQueryCount": { "const": 33 },
        "authoredFiles": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/file" } },
        "snapshotFiles": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/file" } }
      },
      "additionalProperties": false
    },
    "methodology": {
      "type": "object",
      "required": ["question", "selectionProfile", "analysisProfile", "selectionRule", "qualityDefinitions", "evidenceLayers", "interpretationPolicy"],
      "properties": {
        "question": { "type": "string", "minLength": 80 },
        "selectionProfile": { "const": "gaia-dr3-chemical-cartography-balanced-v1" },
        "analysisProfile": { "const": "gaia-dr3-chemical-cartography-interpretation-v1" },
        "selectionRule": { "type": "string", "minLength": 100 },
        "qualityDefinitions": {
          "type": "object",
          "required": ["medium", "high"],
          "properties": { "medium": { "type": "string", "minLength": 60 }, "high": { "type": "string", "minLength": 60 } },
          "additionalProperties": false
        },
        "evidenceLayers": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/evidenceLayer" } },
        "interpretationPolicy": { "$ref": "#/$defs/interpretationPolicy" }
      },
      "additionalProperties": false
    },
    "cohort": {
      "type": "object",
      "required": ["sourceCount", "ruleProfileCount", "highQualityCount", "mediumOnlyCount", "missingRadialVelocityCount", "completePopulationClaim", "candidateAudit", "ruleProfiles"],
      "properties": {
        "sourceCount": { "const": 64 },
        "ruleProfileCount": { "const": 4 },
        "highQualityCount": { "const": 32 },
        "mediumOnlyCount": { "const": 32 },
        "missingRadialVelocityCount": { "const": 0 },
        "completePopulationClaim": { "const": false },
        "candidateAudit": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/candidateAudit" } },
        "ruleProfiles": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/ruleProfile" } }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/record" }
    },
    "qualityAblation": {
      "type": "object",
      "required": ["baseline", "strict", "sourceMutation", "interpretationResult"],
      "properties": {
        "baseline": { "$ref": "#/$defs/qualityView" },
        "strict": { "$ref": "#/$defs/qualityView" },
        "sourceMutation": { "const": false },
        "interpretationResult": { "type": "string", "minLength": 80 }
      },
      "additionalProperties": false
    },
    "evidenceAblation": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["regime", "visibleLayers", "classificationStatus", "historicalInterpretationStatus", "reason"],
        "properties": {
          "regime": { "enum": ["observed-only", "observed-plus-gaia-derived", "through-published-derived", "full-bounded-context"] },
          "visibleLayers": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "type": "string" } },
          "classificationStatus": { "enum": ["unresolved", "rule-supported"] },
          "historicalInterpretationStatus": { "enum": ["unresolved", "withheld", "candidate-compatibility-only"] },
          "reason": { "type": "string", "minLength": 50 }
        },
        "additionalProperties": false
      }
    },
    "historicalInterpretations": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/historicalInterpretation" } },
    "reconstruction": {
      "type": "object",
      "required": ["status", "trueFormationHistoryRecovered", "alternativeInterpretationsAllowed", "result"],
      "properties": {
        "status": { "const": "candidate-interpretations-only" },
        "trueFormationHistoryRecovered": { "const": false },
        "alternativeInterpretationsAllowed": { "const": true },
        "result": { "type": "string", "minLength": 80 }
      },
      "additionalProperties": false
    },
    "historicalLoad": {
      "type": "object",
      "required": ["status", "value", "reason"],
      "properties": {
        "status": { "const": "not-evaluated" },
        "value": { "type": "null" },
        "reason": { "type": "string", "minLength": 80 }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": ["sourceRecords", "recordsWithAllFourParameterIntervals", "recordsWithAllNineOrbitIntervals", "missingRadialVelocitiesPreserved", "missingRadialVelocitiesConvertedToZero", "directObservationOrbitPromotions", "nativeGaiaPopulationLabelsInvented", "birthOriginClaims", "commonAncestryClaims", "liveQueriesDuringBuild"],
      "properties": {
        "sourceRecords": { "const": 64 }, "recordsWithAllFourParameterIntervals": { "const": 64 }, "recordsWithAllNineOrbitIntervals": { "const": 64 },
        "missingRadialVelocitiesPreserved": { "const": 0 }, "missingRadialVelocitiesConvertedToZero": { "const": 0 }, "directObservationOrbitPromotions": { "const": 0 },
        "nativeGaiaPopulationLabelsInvented": { "const": 0 }, "birthOriginClaims": { "const": 0 }, "commonAncestryClaims": { "const": 0 }, "liveQueriesDuringBuild": { "const": 0 }
      },
      "additionalProperties": false
    },
    "evidenceBoundary": {
      "type": "object",
      "required": ["observationIsOrbit", "parameterEstimateIsObservation", "ruleProfileIsPublishedPopulationLabel", "ruleProfileIsBirthOrigin", "chemicalSimilarityIsCommonAncestry", "sampleIsCompleteMilkyWayPopulation", "uncertaintyIntervalsRetained"],
      "properties": {
        "observationIsOrbit": { "const": false }, "parameterEstimateIsObservation": { "const": false }, "ruleProfileIsPublishedPopulationLabel": { "const": false },
        "ruleProfileIsBirthOrigin": { "const": false }, "chemicalSimilarityIsCommonAncestry": { "const": false }, "sampleIsCompleteMilkyWayPopulation": { "const": false }, "uncertaintyIntervalsRetained": { "const": true }
      },
      "additionalProperties": false
    },
    "nonClaims": { "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 20 } },
    "disclaimer": { "type": "string", "minLength": 100 },
    "caseIdentity": { "$ref": "#/$defs/identity" }
  },
  "$defs": {
    "identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "file": {
      "type": "object", "required": ["path", "identity", "bytes"],
      "properties": { "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" }, "identity": { "$ref": "#/$defs/identity" }, "bytes": { "type": "integer", "minimum": 1 } },
      "additionalProperties": false
    },
    "tableLock": {
      "type": "object", "required": ["name", "doi", "role"],
      "properties": { "name": { "type": "string", "pattern": "^gaiadr3\\." }, "doi": { "type": "string", "pattern": "^10\\.17876/gaia/dr\\.3/[0-9]+$" }, "role": { "type": "string", "minLength": 20 } },
      "additionalProperties": false
    },
    "paper": {
      "type": "object", "required": ["title", "journal", "doi", "url", "pdfSha256", "qualityProfileLocator"],
      "properties": { "title": { "type": "string", "minLength": 20 }, "journal": { "type": "string", "minLength": 20 }, "doi": { "const": "10.1051/0004-6361/202243511" }, "url": { "type": "string", "pattern": "^https://doi\\.org/" }, "pdfSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "qualityProfileLocator": { "const": "Appendix B" } },
      "additionalProperties": false
    },
    "profileId": { "enum": ["cold-rotating-metal-rich", "alpha-raised-intermediate", "radial-metal-poor", "counter-rotating-metal-poor"] },
    "evidenceLayer": {
      "type": "object", "required": ["id", "authority", "role"],
      "properties": { "id": { "enum": ["observed", "gaia-derived", "published-derived", "onto2d-classified", "publication-context"] }, "authority": { "type": "string", "minLength": 5 }, "role": { "type": "string", "minLength": 30 } },
      "additionalProperties": false
    },
    "interpretationPolicy": {
      "type": "object", "required": ["status", "assignmentAuthority", "birthOriginAllowed", "commonAncestryAllowed", "singleTrueFormationHistoryAllowed", "alternativeInterpretationsAllowed"],
      "properties": { "status": { "const": "candidate-compatibility-only" }, "assignmentAuthority": { "const": "Onto2D rule profile" }, "birthOriginAllowed": { "const": false }, "commonAncestryAllowed": { "const": false }, "singleTrueFormationHistoryAllowed": { "const": false }, "alternativeInterpretationsAllowed": { "const": true } },
      "additionalProperties": false
    },
    "candidateAudit": {
      "type": "object", "required": ["ruleProfileId", "candidateCount", "mediumEligibleCount", "highEligibleCount", "mediumOnlyEligibleCount", "selectedHighCount", "selectedMediumOnlyCount"],
      "properties": { "ruleProfileId": { "$ref": "#/$defs/profileId" }, "candidateCount": { "const": 1600 }, "mediumEligibleCount": { "type": "integer", "minimum": 16 }, "highEligibleCount": { "type": "integer", "minimum": 8 }, "mediumOnlyEligibleCount": { "type": "integer", "minimum": 8 }, "selectedHighCount": { "const": 8 }, "selectedMediumOnlyCount": { "const": 8 } },
      "additionalProperties": false
    },
    "ruleProfile": {
      "type": "object", "required": ["id", "label", "candidatePredicate", "rule", "interpretations"],
      "properties": { "id": { "$ref": "#/$defs/profileId" }, "label": { "type": "string", "minLength": 20 }, "candidatePredicate": { "type": "string", "minLength": 20 }, "rule": { "type": "string", "minLength": 30 }, "interpretations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 20 } } },
      "additionalProperties": false
    },
    "summary": {
      "type": "object", "required": ["ruleProfileId", "qualityRegime", "sourceCount", "medianMetallicity", "medianAlphaToIron", "medianAzimuthalVelocity", "medianEccentricity", "medianMaximumHeight", "patternSurvives"],
      "properties": { "ruleProfileId": { "$ref": "#/$defs/profileId" }, "qualityRegime": { "enum": ["medium", "high"] }, "sourceCount": { "enum": [8, 16] }, "medianMetallicity": { "type": "number" }, "medianAlphaToIron": { "type": "number" }, "medianAzimuthalVelocity": { "type": "number" }, "medianEccentricity": { "type": "number", "minimum": 0, "maximum": 1 }, "medianMaximumHeight": { "type": "number", "minimum": 0 }, "patternSurvives": { "const": true } },
      "additionalProperties": false
    },
    "qualityView": {
      "type": "object", "required": ["id", "sourceCount", "summaries"],
      "properties": { "id": { "enum": ["medium", "high"] }, "sourceCount": { "enum": [32, 64] }, "excludedSourceCount": { "const": 32 }, "summaries": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/summary" } } },
      "additionalProperties": false
    },
    "historicalInterpretation": {
      "type": "object", "required": ["ruleProfileId", "statements", "status", "supportingSourceCount", "survivesHighQualityAblation", "recoveredBirthOrigin", "commonAncestryClaim", "singleFormationHistoryClaim"],
      "properties": { "ruleProfileId": { "$ref": "#/$defs/profileId" }, "statements": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 20 } }, "status": { "const": "compatible-pattern-only" }, "supportingSourceCount": { "const": 16 }, "survivesHighQualityAblation": { "const": true }, "recoveredBirthOrigin": { "const": false }, "commonAncestryClaim": { "const": false }, "singleFormationHistoryClaim": { "const": false } },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": ["value", "uncertainty", "unit", "missing"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "uncertainty": { "type": ["number", "null"], "minimum": 0 },
        "unit": { "type": "string", "minLength": 1 },
        "missing": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "required": ["point", "lower", "upper", "unit"],
      "properties": {
        "point": { "type": "number" },
        "lower": { "type": "number" },
        "upper": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": ["sourceId", "ruleProfileId", "qualityProfile", "observation", "gaiaEstimate", "publishedOrbit", "assignment", "identity"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^[0-9]{10,19}$" },
        "ruleProfileId": { "enum": ["cold-rotating-metal-rich", "alpha-raised-intermediate", "radial-metal-poor", "counter-rotating-metal-poor"] },
        "qualityProfile": { "enum": ["high", "medium-only"] },
        "observation": {
          "type": "object",
          "required": ["designation", "skyPosition", "parallax", "properMotion", "radialVelocity", "photometry", "ruwe", "evidenceState"],
          "properties": {
            "designation": { "type": "string" },
            "skyPosition": { "type": "object", "required": ["ra", "dec"], "properties": { "ra": { "$ref": "#/$defs/measurement" }, "dec": { "$ref": "#/$defs/measurement" } }, "additionalProperties": false },
            "parallax": { "$ref": "#/$defs/measurement" },
            "properMotion": { "type": "object", "required": ["ra", "dec"], "properties": { "ra": { "$ref": "#/$defs/measurement" }, "dec": { "$ref": "#/$defs/measurement" } }, "additionalProperties": false },
            "radialVelocity": { "$ref": "#/$defs/measurement" },
            "photometry": { "type": "object", "required": ["gMeanMagnitude", "bpMinusRp"], "properties": { "gMeanMagnitude": { "type": "number" }, "bpMinusRp": { "type": "number" } }, "additionalProperties": false },
            "ruwe": { "type": "number" },
            "evidenceState": { "const": "gaia-catalogue-observation" }
          },
          "additionalProperties": false
        },
        "gaiaEstimate": {
          "type": "object", "required": ["effectiveTemperature", "surfaceGravity", "metallicity", "alphaToIron", "flags", "evidenceState"],
          "properties": { "effectiveTemperature": { "$ref": "#/$defs/interval" }, "surfaceGravity": { "$ref": "#/$defs/interval" }, "metallicity": { "$ref": "#/$defs/interval" }, "alphaToIron": { "$ref": "#/$defs/interval" }, "flags": { "type": "string", "pattern": "^[0-9]{13,}$" }, "evidenceState": { "const": "gaia-apsis-estimate" } },
          "additionalProperties": false
        },
        "publishedOrbit": {
          "type": "object", "required": ["rplane", "radialVelocity", "verticalVelocity", "azimuthalVelocity", "maximumHeight", "eccentricity", "radialAction", "verticalAction", "azimuthalAction", "energy", "evidenceState"],
          "properties": { "rplane": { "$ref": "#/$defs/interval" }, "radialVelocity": { "$ref": "#/$defs/interval" }, "verticalVelocity": { "$ref": "#/$defs/interval" }, "azimuthalVelocity": { "$ref": "#/$defs/interval" }, "maximumHeight": { "$ref": "#/$defs/interval" }, "eccentricity": { "$ref": "#/$defs/interval" }, "radialAction": { "$ref": "#/$defs/interval" }, "verticalAction": { "$ref": "#/$defs/interval" }, "azimuthalAction": { "$ref": "#/$defs/interval" }, "energy": { "type": "object", "required": ["point", "unit"], "properties": { "point": { "type": "number" }, "unit": { "const": "km2/s2" } }, "additionalProperties": false }, "evidenceState": { "const": "published-companion-derived" } },
          "additionalProperties": false
        },
        "assignment": {
          "type": "object",
          "required": ["ruleProfileId", "authority", "nativeGaiaLabel", "birthOriginClaim", "commonAncestryClaim", "evidenceState"],
          "properties": {
            "ruleProfileId": { "$ref": "#/$defs/profileId" },
            "authority": { "const": "Onto2D deterministic rule profile" },
            "nativeGaiaLabel": { "const": false },
            "birthOriginClaim": { "const": false },
            "commonAncestryClaim": { "const": false },
            "evidenceState": { "const": "onto2d-classified" }
          },
          "additionalProperties": false
        },
        "identity": { "$ref": "#/$defs/identity" }
      },
      "additionalProperties": false
    }
  }
}
