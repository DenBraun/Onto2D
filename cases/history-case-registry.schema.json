{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/history-case-registry.schema.json",
  "title": "Onto2D History Case Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taxonomyVersion", "historyModes", "effects", "maturityLevels", "cases"],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "taxonomyVersion": { "type": "string", "format": "date" },
    "historyModes": {
      "type": "array",
      "const": ["recorded", "embodied", "reconstructed"]
    },
    "effects": {
      "type": "array",
      "const": ["identity", "present-state", "future"]
    },
    "maturityLevels": {
      "type": "array",
      "const": ["DISCOVERED", "PLANNED", "SOURCE_PINNED", "EXTRACTABLE", "REPRODUCIBLE", "MODEL_PACK", "EXPLORER", "ANALYSIS_READY", "REVIEWED"]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "nullableId": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nullablePath": {
      "type": ["string", "null"],
      "pattern": "^(?:apps|models)/[A-Za-z0-9._/-]+/$"
    },
    "nullableVersion": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "analysisLevel": {
      "enum": ["primary", "secondary", "candidate", "relevant", "possible", "descriptive-only", "not-primary"]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId", "portfolioOrder", "title", "shortTitle", "domain", "domainLabel",
        "status", "priority", "primaryHistoryMode", "historyModes", "primaryEffects",
        "secondaryEffects", "matrixPlacements", "evidenceProfile", "analyses", "modelId", "modelVersion", "modelPackPath",
        "explorerId", "explorerPath", "casePagePath", "implementationDoc"
      ],
      "properties": {
        "caseId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "portfolioOrder": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 3 },
        "shortTitle": { "type": "string", "minLength": 2 },
        "domain": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "domainLabel": { "type": "string", "minLength": 2 },
        "status": { "enum": ["DISCOVERED", "PLANNED", "SOURCE_PINNED", "EXTRACTABLE", "REPRODUCIBLE", "MODEL_PACK", "EXPLORER", "ANALYSIS_READY", "REVIEWED"] },
        "priority": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "primaryHistoryMode": { "enum": ["recorded", "embodied", "reconstructed"] },
        "historyModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["recorded", "embodied", "reconstructed"] }
        },
        "primaryEffects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["identity", "present-state", "future"] }
        },
        "secondaryEffects": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["identity", "present-state", "future"] }
        },
        "matrixPlacements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "effect", "role"],
            "properties": {
              "mode": { "enum": ["recorded", "embodied", "reconstructed"] },
              "effect": { "enum": ["identity", "present-state", "future"] },
              "role": { "enum": ["primary", "secondary"] }
            }
          }
        },
        "evidenceProfile": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["direct-record", "direct-measurement", "experimental-observation", "sample-identity", "attested", "cryptographically-verified", "published-interpretation", "derived", "reconstructed", "inferred", "counterfactual", "unknown", "contested"]
          }
        },
        "analyses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["historicalLoad", "historyEquivalence", "reachability", "reconstruction"],
          "properties": {
            "historicalLoad": { "$ref": "#/$defs/analysisLevel" },
            "historyEquivalence": { "$ref": "#/$defs/analysisLevel" },
            "reachability": { "$ref": "#/$defs/analysisLevel" },
            "reconstruction": { "$ref": "#/$defs/analysisLevel" }
          }
        },
        "modelId": { "$ref": "#/$defs/nullableId" },
        "modelVersion": { "$ref": "#/$defs/nullableVersion" },
        "modelPackPath": { "$ref": "#/$defs/nullablePath" },
        "explorerId": { "$ref": "#/$defs/nullableId" },
        "explorerPath": { "$ref": "#/$defs/nullablePath" },
        "casePagePath": { "type": "string", "pattern": "^apps/external-cases/[a-z0-9-]+/$" },
        "implementationDoc": { "type": "string", "pattern": "^docs/cases/[A-Z0-9_]+_IMPLEMENTATION\\.md$" }
      }
    }
  }
}
