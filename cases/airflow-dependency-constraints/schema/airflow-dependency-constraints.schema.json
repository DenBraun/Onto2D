{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto2d.dev/schemas/cases/airflow-dependency-constraints-v1.schema.json",
  "title": "Onto2D Airflow Dependency Constraints Case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "formatVersion", "caseVersion", "generatedBy", "scope", "source",
    "constraint", "analysisProfile", "candidateUniverse", "solutions", "resolverDiagnostics",
    "sharedDependencies", "historicalLoad", "constraintAblations", "experiments",
    "limitations", "caseIdentity"
  ],
  "properties": {
    "format": { "const": "onto2d-airflow-dependency-constraints-case" },
    "formatVersion": { "const": "1" },
    "caseVersion": { "const": "airflow-dependency-constraints-v1" },
    "generatedBy": { "const": "cases/airflow-dependency-constraints/extract.mjs" },
    "scope": { "$ref": "#/$defs/scope" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "lock", "constraintFile", "airflowRoot", "airflowCoreRoot"],
      "properties": {
        "identity": { "$ref": "#/$defs/hash" },
        "lock": { "type": "object" },
        "constraintFile": { "$ref": "#/$defs/sourceFile" },
        "airflowRoot": { "$ref": "#/$defs/projectSource" },
        "airflowCoreRoot": { "$ref": "#/$defs/projectSource" }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceClass", "entryCount", "entries", "selectedPins"],
      "properties": {
        "evidenceClass": { "const": "official-versioned-airflow-constraint-file" },
        "entryCount": { "type": "integer", "minimum": 1 },
        "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/constraintPin" } },
        "selectedPins": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/projectVersion" } }
      }
    },
    "analysisProfile": { "type": "object" },
    "candidateUniverse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectCount", "candidateCount", "candidates"],
      "properties": {
        "projectCount": { "const": 17 },
        "candidateCount": { "const": 24 },
        "candidates": { "type": "array", "minItems": 24, "maxItems": 24, "items": { "$ref": "#/$defs/candidate" } }
      }
    },
    "solutions": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/solution" }
    },
    "resolverDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignmentsConsidered", "acceptedSolutions", "rejectedAssignments", "rejectionCounts"],
      "properties": {
        "assignmentsConsidered": { "const": 128 },
        "acceptedSolutions": { "const": 64 },
        "rejectedAssignments": { "const": 64 },
        "rejectionCounts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason", "count"],
            "properties": { "reason": { "type": "string", "minLength": 1 }, "count": { "type": "integer", "minimum": 1 } }
          }
        }
      }
    },
    "sharedDependencies": { "type": "array", "items": { "$ref": "#/$defs/sharedDependency" } },
    "historicalLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "profileIdentity", "results", "resolverDiagnosticsUsedAsCost"],
      "properties": {
        "status": { "const": "resolved-in-declared-projection" },
        "profileIdentity": { "$ref": "#/$defs/hash" },
        "results": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/loadResult" } },
        "resolverDiagnosticsUsedAsCost": { "const": false }
      }
    },
    "constraintAblations": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/ablation" } },
    "experiments": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "object" } },
    "limitations": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 1 } },
    "caseIdentity": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "project": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["airflowRelease", "rootProject", "rootVersion", "pythonVersion", "platform", "projectionId", "constraintPath", "boundary"],
      "properties": {
        "airflowRelease": { "const": "3.3.1" },
        "rootProject": { "const": "apache-airflow-core" },
        "rootVersion": { "const": "3.3.1" },
        "pythonVersion": { "const": "3.12" },
        "platform": { "const": "manylinux-x86_64" },
        "projectionId": { "const": "airflow-core-five-requirement-projection-v1" },
        "constraintPath": { "const": "constraints-no-providers-3.12.txt" },
        "boundary": { "type": "string", "minLength": 40 }
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "url", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "projectSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "url", "size", "sha256", "project", "version"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "project": { "$ref": "#/$defs/project" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "projectVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "version"],
      "properties": { "project": { "$ref": "#/$defs/project" }, "version": { "type": "string", "minLength": 1 } }
    },
    "constraintPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "version", "sourceLine"],
      "properties": {
        "project": { "$ref": "#/$defs/project" },
        "version": { "type": "string", "minLength": 1 },
        "sourceLine": { "type": "string", "pattern": "==" }
      }
    },
    "wheel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "url", "size", "sha256", "packagetype", "pythonVersion", "requiresPython"],
      "properties": {
        "filename": { "type": "string", "pattern": "\\.whl$" },
        "url": { "type": "string", "pattern": "^https://files\\.pythonhosted\\.org/" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "packagetype": { "const": "bdist_wheel" },
        "pythonVersion": { "type": "string" },
        "requiresPython": { "type": ["string", "null"] }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "project", "version", "requiresPython", "dependencies", "wheel", "source"],
      "properties": {
        "candidateId": { "type": "string", "pattern": "==" },
        "project": { "$ref": "#/$defs/project" },
        "version": { "type": "string", "minLength": 1 },
        "requiresPython": { "type": ["string", "null"] },
        "dependencies": { "type": "array", "items": { "type": "object" } },
        "wheel": { "$ref": "#/$defs/wheel" },
        "source": { "$ref": "#/$defs/projectSource" }
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wheel-download-bytes", "environment-change-actions", "selected-wheel-count"],
      "properties": {
        "wheel-download-bytes": { "type": "integer", "minimum": 1 },
        "environment-change-actions": { "type": "integer", "minimum": 0 },
        "selected-wheel-count": { "const": 17 }
      }
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selections", "environmentIdentity", "costs", "constraintCompliant", "solutionId"],
      "properties": {
        "selections": { "type": "array", "minItems": 17, "maxItems": 17, "items": { "$ref": "#/$defs/projectVersion" } },
        "environmentIdentity": { "$ref": "#/$defs/hash" },
        "costs": { "$ref": "#/$defs/costs" },
        "constraintCompliant": { "type": "boolean" },
        "solutionId": { "$ref": "#/$defs/hash" }
      }
    },
    "optimum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solutionCount", "optimumCost", "optimumSolutionIds"],
      "properties": {
        "solutionCount": { "type": "integer", "minimum": 1 },
        "optimumCost": { "type": "integer", "minimum": 0 },
        "optimumSolutionIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hash" } }
      }
    },
    "loadResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["costFunction", "unit", "definition", "relaxedProjects", "free", "constrained", "historicalLoad"],
      "properties": {
        "costFunction": { "enum": ["wheel-download-bytes", "environment-change-actions", "selected-wheel-count"] },
        "unit": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "relaxedProjects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
        "free": { "$ref": "#/$defs/optimum" },
        "constrained": { "$ref": "#/$defs/optimum" },
        "historicalLoad": { "type": "integer", "minimum": 0 }
      }
    },
    "ablation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relaxedProjects", "results"],
      "properties": {
        "id": { "type": "string", "pattern": "^relax-" },
        "relaxedProjects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/project" } },
        "results": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/loadResult" } }
      }
    },
    "sharedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "consumers", "consumerCount"],
      "properties": {
        "project": { "$ref": "#/$defs/project" },
        "consumers": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "consumerCount": { "type": "integer", "minimum": 2 }
      }
    }
  }
}
